<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Scanalyse.Core</RootNamespace>
    <AssemblyName>Scanalyse.Core</AssemblyName>
    <Description>Cœur d'analyse de Scanalyse : interprétation du contenu des codes-barres, GS1 et diagnostic de lecture.</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Scanalyse.Core.Tests" />
  </ItemGroup>

</Project>
