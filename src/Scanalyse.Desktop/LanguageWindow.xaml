<Window x:Class="Scanalyse.Desktop.LanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scanalyse"
        Icon="/Assets/Scanalyse.ico"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource UiFont}" FontSize="14" KeyDown="Window_KeyDown">

  <!-- Premier lancement : choix de la langue, avant l'accueil et la visite guidée (textes volontairement bilingues) -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="LangCard" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Card" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1.5" CornerRadius="14" Padding="20,18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter />
                <Border x:Name="Dot" Grid.Column="1" Width="20" Height="20" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Line}" VerticalAlignment="Top">
                  <Ellipse x:Name="Inner" Width="10" Height="10" Fill="{DynamicResource BrandText}" Visibility="Collapsed" />
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Surface2}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BrandText}" />
                <Setter TargetName="Card" Property="Background" Value="{DynamicResource BrandSoft}" />
                <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource BrandText}" />
                <Setter TargetName="Inner" Property="Visibility" Value="Visible" />
              </Trigger>

            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <StackPanel>
      <Grid Height="38" Background="{DynamicResource TitleBg}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Image Source="/Assets/logo-64.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="Scanalyse" Margin="10,0,0,0" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TitleInk}" VerticalAlignment="Center" />
        </StackPanel>
        <Button Style="{StaticResource BtnCaptionClose}" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True" Click="Continue_Click" ToolTip="Continuer · Continue">
          <Path Data="M0 0l10 10M10 0L0 10" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
        </Button>
      </Grid>

      <StackPanel Margin="32,28,32,28">
        <TextBlock Text="Bienvenue · Welcome" Style="{StaticResource PageTitle}" FontSize="24" />
        <TextBlock Margin="0,6,0,22" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                   Text="Choisissez la langue de Scanalyse · Choose the language for Scanalyse" />

        <RadioButton x:Name="French" Style="{StaticResource LangCard}" GroupName="Lang" Margin="0,0,0,12" MouseDoubleClick="Card_DoubleClick">
          <StackPanel>
            <TextBlock Text="Français" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="Interface, rapports PDF et messages en français" Margin="0,4,0,0" FontSize="12.5" Foreground="{DynamicResource Muted}" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="English" Style="{StaticResource LangCard}" GroupName="Lang" MouseDoubleClick="Card_DoubleClick">
          <StackPanel>
            <TextBlock Text="English" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="Interface, PDF reports and messages in English" Margin="0,4,0,0" FontSize="12.5" Foreground="{DynamicResource Muted}" />
          </StackPanel>
        </RadioButton>

        <DockPanel Margin="0,24,0,0" LastChildFill="False">
          <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" MaxWidth="290"
                     Text="Modifiable ensuite dans Paramètres · Can be changed later in Settings" />
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnAction}" Content="Continuer · Continue" MinWidth="170" IsDefault="True" Click="Continue_Click" />
        </DockPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
