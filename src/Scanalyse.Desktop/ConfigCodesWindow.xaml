<Window x:Class="Scanalyse.Desktop.ConfigCodesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codes de configuration — Scanalyse"
        Icon="/Assets/Scanalyse.ico"
        Width="900" Height="760" MinWidth="560" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        ShowInTaskbar="False" StateChanged="Window_StateChanged" KeyDown="Window_KeyDown">

  <!-- Codes-barres de configuration des douchettes, à scanner à l'écran ou sur papier -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Border x:Name="RootBorder" BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Background="{DynamicResource TitleBg}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Image Source="/Assets/logo-64.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="Codes de configuration" Margin="10,0,0,0" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TitleInk}" VerticalAlignment="Center" />
          <TextBlock Text="Scanalyse" Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource TitleMuted}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource BtnCaption}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click" ToolTip="Agrandir / restaurer">
            <Path x:Name="MaxIcon" Data="M0.5 0.5h9v9h-9z" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
          </Button>
          <Button Style="{StaticResource BtnCaptionClose}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="Fermer">
            <Path Data="M0 0l10 10M10 0L0 10" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
          </Button>
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="1" Margin="24,18,24,8">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Content="Imprimer…" Click="Print_Click" VerticalAlignment="Center" />
          <WrapPanel x:Name="BrandChips" VerticalAlignment="Center">
            <RadioButton Style="{StaticResource Chip}" GroupName="Brand" Tag="Honeywell" Content="Honeywell" IsChecked="True" Checked="Brand_Checked" />
            <RadioButton Style="{StaticResource Chip}" GroupName="Brand" Tag="Datalogic" Content="Datalogic" Checked="Brand_Checked" />
            <RadioButton Style="{StaticResource Chip}" GroupName="Brand" Tag="Zebra" Content="Zebra" Checked="Brand_Checked" />
          </WrapPanel>
        </DockPanel>
        <TextBlock x:Name="BrandNote" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,10,0,0" />
      </StackPanel>

      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,4,24,20">
        <StackPanel x:Name="CodesPanel" />
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
