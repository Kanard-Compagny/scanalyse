<Window x:Class="Scanalyse.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:views="clr-namespace:Scanalyse.Desktop.Views"
        xmlns:local="clr-namespace:Scanalyse.Desktop"
        Title="Scanalyse"
        Icon="/Assets/Scanalyse.ico"
        Width="1380" Height="880" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        StateChanged="Window_StateChanged" SizeChanged="Window_SizeChanged">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Border x:Name="RootBorder">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Barre de titre -->
      <Grid Background="{DynamicResource TitleBg}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Image Source="/Assets/logo-64.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="Scanalyse" Margin="10,0,0,0" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TitleInk}" VerticalAlignment="Center" />
          <TextBlock x:Name="VersionText" Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource TitleMuted}" VerticalAlignment="Center" />
          <!-- Nouvelle version disponible (dossier de l'équipe ou GitHub) -->
          <Button x:Name="UpdateButton" Visibility="Collapsed" Margin="12,0,0,0" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="UpdateButton_Click" ToolTip="Installer la nouvelle version de Scanalyse (redémarrage)">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{DynamicResource TitleHover}" CornerRadius="11" Padding="9,3,11,3">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Action}" VerticalAlignment="Center" />
                    <TextBlock x:Name="UpdateText" Text="{TemplateBinding Content}" Margin="7,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TitleInk}" />
                  </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SideActiveBg}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource BtnCaption}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" ToolTip="Réduire">
            <Path Data="M0 5h10" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
          </Button>
          <Button Style="{StaticResource BtnCaption}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click" ToolTip="Agrandir / restaurer">
            <Path x:Name="MaxIcon" Data="M0.5 0.5h9v9h-9z" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
          </Button>
          <Button Style="{StaticResource BtnCaptionClose}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="Fermer">
            <Path Data="M0 0l10 10M10 0L0 10" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Barre d'outils -->
      <Border x:Name="ToolbarHost" Grid.Row="1" MinHeight="60" Background="{DynamicResource ToolbarBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
        <DockPanel Margin="16,0" LastChildFill="False">
          <StackPanel x:Name="ToolbarLeft" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Source" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button Style="{StaticResource BtnSecondary}" Click="Source_Click" ToolTip="Choisir comment la douchette est reliée au PC">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="SourceDot" Width="8" Height="8" Fill="{DynamicResource Muted}" VerticalAlignment="Center" />
                <TextBlock x:Name="SourceText" Text="Douchette en mode clavier" Margin="10,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Rectangle Width="1" Height="28" Fill="{DynamicResource Line}" Margin="14,0" />
            <Button Style="{StaticResource BtnSecondary}" Click="Import_Click" Margin="0,0,8,0" ToolTip="Ouvrir une image ou une photo à analyser (Ctrl + O)">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="16" Height="16"><Path Data="{StaticResource IconImport}" Width="24" Height="24" Stroke="{DynamicResource BrandText}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                <TextBlock x:Name="ImportLabel" Text="Importer une image" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource BtnSecondary}" Click="Paste_Click" ToolTip="Analyser l'image du presse-papiers (Ctrl + Maj + V)">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="16" Height="16"><Path Data="{StaticResource IconPaste}" Width="24" Height="24" Stroke="{DynamicResource BrandText}" StrokeThickness="1.8" StrokeLineJoin="Round" /></Viewbox>
                <TextBlock x:Name="PasteLabel" Text="Coller une image" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource BtnSecondary}" Click="Capture_Click" Margin="8,0,0,0" ToolTip="Sélectionner une zone de l'écran avec l'outil Capture de Windows">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="16" Height="16"><Path Data="{StaticResource IconCapture}" Width="24" Height="24" Stroke="{DynamicResource BrandText}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                <TextBlock x:Name="CaptureLabel" Text="Capturer une zone" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource BtnSecondary}" Click="Camera_Click" Margin="8,0,0,0" ToolTip="Lire les codes en direct avec une webcam ou une caméra document">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="16" Height="16"><Path Data="{StaticResource IconCamera}" Width="24" Height="24" Stroke="{DynamicResource BrandText}" StrokeThickness="1.8" StrokeLineJoin="Round" /></Viewbox>
                <TextBlock x:Name="CameraLabel" Text="Caméra" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
          </StackPanel>
          <Button x:Name="ThemeButton" DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Click="Theme_Click" VerticalAlignment="Center" ToolTip="Changer de thème">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="16" Height="16"><Path Data="{StaticResource IconTheme}" Width="24" Height="24" Stroke="{DynamicResource Muted}" StrokeThickness="1.8" StrokeLineJoin="Round" /></Viewbox>
              <TextBlock x:Name="ThemeLabel" Text="Thème : Système" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
          <Button x:Name="CaseButton" DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Click="CaseButton_Click" VerticalAlignment="Center" Margin="0,0,8,0"
                  ToolTip="Dossier SAV dans lequel les analyses sont enregistrées">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="16" Height="16"><Path Data="{StaticResource IconFolder}" Width="24" Height="24" Stroke="{DynamicResource BrandText}" StrokeThickness="1.8" StrokeLineJoin="Round" /></Viewbox>
              <TextBlock x:Name="CaseLabel" Text="Dossier : Non classé" Margin="8,0,0,0" MaxWidth="260" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>
        </DockPanel>
      </Border>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menu latéral -->
        <Border x:Name="Sidebar" Width="236" Background="{DynamicResource SideBg}" ClipToBounds="True">
          <DockPanel Margin="12,14,12,14">
            <StackPanel DockPanel.Dock="Bottom">
              <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="{StaticResource IconSettings}" Content="Paramètres" ToolTip="Paramètres" Checked="Nav_Checked" />
            </StackPanel>
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnCaption}" Width="34" Height="30" Click="ToggleMenu_Click"
                        Foreground="{DynamicResource SideMuted}" ToolTip="Réduire ou déployer le menu">
                  <Viewbox Width="14" Height="14">
                    <Path x:Name="MenuChevron" Data="{StaticResource IconChevronLeft}" Width="24" Height="24"
                          Stroke="{DynamicResource SideMuted}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Viewbox>
                </Button>
                <TextBlock x:Name="MenuLabel" Text="MENU" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SideMuted}" VerticalAlignment="Center" Margin="12,0,0,0" />
              </DockPanel>
              <RadioButton x:Name="NavAnalyse" Style="{StaticResource NavItem}" Tag="{StaticResource IconAnalyse}" Content="Analyser une image" ToolTip="Analyser une image" Checked="Nav_Checked" />
              <RadioButton x:Name="NavCreate" Style="{StaticResource NavItem}" Tag="{StaticResource IconCreate}" Content="Créer un code" ToolTip="Créer un code" Checked="Nav_Checked" />
              <RadioButton x:Name="NavPrint" Style="{StaticResource NavItem}" Tag="{StaticResource IconPrint}" Content="Étiquette imprimante" ToolTip="Étiquette imprimante (ZPL, TSPL, EPL2, DPL, SBPL, Fingerprint)" Checked="Nav_Checked" />
              <RadioButton x:Name="NavConfig" Style="{StaticResource NavItem}" Tag="{StaticResource IconPrinterConfig}" Content="Conf imprimante" ToolTip="Conf imprimante : fichiers de configuration (ZPL, SGD, TSPL, DPL, SBPL, Fingerprint) expliqués, contrôlés et envoyés" Checked="Nav_Checked" />
              <RadioButton x:Name="NavBench" Style="{StaticResource NavItem}" Tag="{StaticResource IconBench}" Content="Banc d'essai douchette" ToolTip="Banc d'essai douchette" Checked="Nav_Checked" />
              <RadioButton x:Name="NavDevices" Style="{StaticResource NavItem}" Tag="{StaticResource IconScanner}" Content="Appareils de lecture" ToolTip="Appareils de lecture : douchettes, terminaux Android, caméras" Checked="Nav_Checked" />
              <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" Tag="{StaticResource IconHistory}" Content="Historique" ToolTip="Historique et rapports" Checked="Nav_Checked" />
              <RadioButton x:Name="NavSymbols" Style="{StaticResource NavItem}" Tag="{StaticResource IconSymbols}" Content="Symbologies" ToolTip="Symbologies" Checked="Nav_Checked" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Contenu -->
        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid x:Name="AtelierPage">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="AtelierHeader" Margin="28,22,28,6">
              <TextBlock x:Name="AtelierTitle" Style="{StaticResource PageTitle}" Text="Analyser une image" />
              <TextBlock x:Name="AtelierSubtitle" Style="{StaticResource PageSubtitle}"
                         Text="Importe, colle ou capture une image : chaque code est lu, détaillé et peut être comparé à une lecture douchette." />
            </StackPanel>
            <Grid Grid.Row="1">
              <wv2:WebView2 x:Name="Web" />
              <Border x:Name="WebError" Style="{StaticResource Card}" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <StackPanel>
                  <TextBlock Style="{StaticResource CardTitle}" Text="L'Atelier ne peut pas s'afficher" Margin="0,0,0,8" />
                  <TextBlock x:Name="WebErrorText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>
          </Grid>

          <views:BenchView x:Name="Bench" Visibility="Collapsed" />
          <views:PrintView x:Name="PrintPage" Visibility="Collapsed" />
          <views:ConfigView x:Name="ConfigPage" Visibility="Collapsed" />
          <views:DevicesView x:Name="Devices" Visibility="Collapsed" />
          <views:HistoryView x:Name="HistoryPage" Visibility="Collapsed" />
          <views:SymbologiesView x:Name="Symbols" Visibility="Collapsed" />
          <views:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />

          <!-- Journal des lectures -->
          <Border x:Name="LogHost" Grid.Row="1" Margin="28,4,28,18" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource ConsoleBg}">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Height="42" Margin="14,0,8,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Journal des lectures" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource Ink}" />
                <TextBlock x:Name="LogCount" DockPanel.Dock="Left" FontSize="12" Foreground="{DynamicResource ConsoleMuted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Click="ToggleLog_Click" Margin="6,0,0,0" ToolTip="Réduire ou afficher le journal">
                  <Viewbox Width="12" Height="12">
                    <Path x:Name="LogChevron" Data="{StaticResource IconChevronDown}" Width="24" Height="24" Stroke="{DynamicResource Muted}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5" />
                  </Viewbox>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Effacer" Click="ClearLog_Click" Margin="6,0,0,0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Copier" Click="CopyLog_Click" />
              </DockPanel>
              <ScrollViewer x:Name="LogScroll" Height="128" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,0,14,10">
                <ItemsControl x:Name="LogList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:LogEntry}">
                      <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="74" />
                          <ColumnDefinition Width="112" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{DynamicResource ConsoleMuted}" />
                        <TextBlock Grid.Column="1" Text="{Binding Tag}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" FontWeight="SemiBold">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource BrandText}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Ok">
                                  <Setter Property="Foreground" Value="{DynamicResource OkFg}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                  <Setter Property="Foreground" Value="{DynamicResource WarnFg}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Error">
                                  <Setter Property="Foreground" Value="{DynamicResource BadFg}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="2" Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{DynamicResource ConsoleInk}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- Confirmations (suppression, actions irréversibles) : par-dessus la barre d'outils et les pages -->
      <views:ConfirmOverlay x:Name="Confirm" Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="110" />
      <!-- Premier lancement : accueil, puis visite guidée -->
      <views:WelcomeOverlay x:Name="Welcome" Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="101" />
      <views:TourOverlay x:Name="Tour" Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="102" />
    </Grid>
  </Border>
</Window>
