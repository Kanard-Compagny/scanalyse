<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 version 2004 minimum : donne accès aux API Windows de point de vente (scanners HID POS). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Scanalyse.Desktop</RootNamespace>
    <AssemblyName>Scanalyse</AssemblyName>
    <Description>Scanalyse : analyse et diagnostic de lecture des codes-barres.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Scanalyse.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scanalyse.Core\Scanalyse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Composant web officiel de Microsoft (moteur Edge, déjà présent sur Windows 10/11) pour afficher l'Atelier. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- Ports série (douchettes RS-232 et ports COM virtuels USB), bibliothèque officielle de Microsoft. -->
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Atelier (création + analyse d'images), généré par web/build.py et embarqué dans l'exécutable. -->
    <EmbeddedResource Include="Web\index.html" LogicalName="Scanalyse.Web.index.html" />
    <!-- Mentions des composants tiers, affichées depuis Paramètres → À propos. -->
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" LogicalName="Scanalyse.ThirdParty.md" />
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="Scanalyse.Changelog.md" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="Scanalyse.License.txt" />
    <!-- Page ouverte dans le navigateur du terminal Android par le relais. -->
    <EmbeddedResource Include="Relay\relais.html" LogicalName="Scanalyse.Relay.relais.html" />
    <EmbeddedResource Include="..\..\web\vendor\zxing-wasm-full-3.1.4.js" LogicalName="Scanalyse.Relay.zxing.js" />
    <EmbeddedResource Include="..\..\web\vendor\zxing_full-3.1.4.wasm" LogicalName="Scanalyse.Relay.zxing.wasm" />
    <!-- Traductions de l'interface (français → anglais), voir Localization.cs. -->
    <EmbeddedResource Include="Lang\en.tsv" LogicalName="Scanalyse.Lang.en.tsv" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Scanalyse.ico" />
    <Resource Include="Assets\logo-64.png" />
    <!-- Écran de démarrage : affiché par Windows dès le lancement, retiré quand la fenêtre est prête (aucune attente ajoutée) -->
    <Resource Include="Assets\splash.png" />
    <Resource Include="Assets\kanard-128.png" />
  </ItemGroup>

</Project>
