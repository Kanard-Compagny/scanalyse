<UserControl UseLayoutRounding="True" x:Class="Scanalyse.Desktop.Views.TourOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" PreviewKeyDown="Root_PreviewKeyDown" Focusable="True">
  <!-- Visite guidée : tout est assombri sauf l'élément présenté, une bulle explique à quoi il sert -->
  <Canvas x:Name="Root" Background="Transparent" SizeChanged="Root_SizeChanged">
    <Path x:Name="Scrim" Fill="#A6000000" />
    <Border x:Name="Ring" BorderBrush="#F07F13" BorderThickness="2.5" CornerRadius="10" IsHitTestVisible="False" />
    <Grid x:Name="Bubble" Width="380">
      <!-- Ombre portée sur un fond à part : un effet posé sur le contenu rendrait le texte flou. -->
      <Border Background="{DynamicResource Surface}" CornerRadius="14" IsHitTestVisible="False">
        <Border.Effect>
        <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.4" Color="#000000" />
      </Border.Effect>
      </Border>
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="18,16">
      <StackPanel>
        <DockPanel>
          <TextBlock x:Name="CountText" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
          <TextBlock x:Name="BubbleTitle" Style="{StaticResource CardTitle}" />
        </DockPanel>
        <TextBlock x:Name="BubbleText" TextWrapping="Wrap" FontSize="13.5" Foreground="{DynamicResource Ink}" Margin="0,8,0,0" LineHeight="19" />
        <DockPanel Margin="0,16,0,0" LastChildFill="False">
          <Button DockPanel.Dock="Left" Style="{StaticResource BtnGhost}" Content="Terminer" Click="End_Click" />
          <Button x:Name="NextButton" DockPanel.Dock="Right" Style="{StaticResource BtnAction}" Content="Suivant" Click="Next_Click" MinWidth="100" />
          <Button x:Name="PrevButton" DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Content="Précédent" Click="Prev_Click" Margin="0,0,8,0" />
        </DockPanel>
      </StackPanel>
    </Border>
    </Grid>
  </Canvas>
</UserControl>
