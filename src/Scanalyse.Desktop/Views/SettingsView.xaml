<UserControl x:Class="Scanalyse.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,22,28,16" MaxWidth="860" HorizontalAlignment="Left">
      <TextBlock Style="{StaticResource PageTitle}" Text="Paramètres" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="Apparence de Scanalyse et informations sur le programme." Margin="0,4,0,20" />

      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="Thème" />
          <TextBlock Style="{StaticResource PageSubtitle}" Text="Le choix est mémorisé. « Système » suit le réglage clair ou sombre de Windows." Margin="0,4,0,14" />
          <UniformGrid Columns="3">
            <RadioButton x:Name="ThemeSystem" Style="{StaticResource ChoiceCard}" GroupName="Theme" Margin="0,0,10,0" Checked="Theme_Checked">
              <StackPanel>
                <TextBlock Text="Système" FontWeight="SemiBold" />
                <TextBlock Text="Comme Windows" FontSize="12" Foreground="{DynamicResource Muted}" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="ThemeLight" Style="{StaticResource ChoiceCard}" GroupName="Theme" Margin="0,0,10,0" Checked="Theme_Checked">
              <StackPanel>
                <TextBlock Text="Clair" FontWeight="SemiBold" />
                <TextBlock Text="Fond blanc, menu vert" FontSize="12" Foreground="{DynamicResource Muted}" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="ThemeDark" Style="{StaticResource ChoiceCard}" GroupName="Theme" Checked="Theme_Checked">
              <StackPanel>
                <TextBlock Text="Sombre" FontWeight="SemiBold" />
                <TextBlock Text="Pour les longues sessions" FontSize="12" Foreground="{DynamicResource Muted}" />
              </StackPanel>
            </RadioButton>
          </UniformGrid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="Historique et rapports" />
          <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,12"
                     Text="Par défaut, l'historique est rangé à côté de Scanalyse.exe : il suit le programme (clé USB, dossier partagé). Choisis un dossier réseau pour que toute l'équipe partage les mêmes dossiers SAV." />
          <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="12,9" Margin="0,0,0,12">
            <TextBlock x:Name="HistoryPath" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" />
          </Border>
          <WrapPanel>
            <Button Style="{StaticResource BtnSecondary}" Content="Changer de dossier…" Click="ChangeHistory_Click" Margin="0,0,8,8" />
            <Button Style="{StaticResource BtnSecondary}" Content="Ouvrir le dossier" Click="OpenHistory_Click" Margin="0,0,8,8" />
            <Button x:Name="ResetHistoryButton" Style="{StaticResource BtnGhost}" Content="Revenir à côté du programme" Click="ResetHistory_Click" Margin="0,0,0,8" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Image Source="/Assets/logo-64.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource CardTitle}" Text="À propos de Scanalyse" />
              <TextBlock x:Name="VersionText" Style="{StaticResource PageSubtitle}" Margin="0,2,0,0" />
            </StackPanel>
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Margin="0,14,0,8"
                     Text="Toute l'analyse est faite sur ce PC : aucune image ni aucune donnée lue n'est envoyée sur Internet." />
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,14"
                     Text="Composants tiers : zxing-cpp (Apache 2.0), zxing-wasm et qr-code-styling (MIT), System.IO.Ports (MIT), Microsoft Edge WebView2." />

          <TextBlock Style="{StaticResource FieldLabel}" Text="Diagnostic (à joindre à une demande d'aide)" />
          <TextBox x:Name="DiagBox" IsReadOnly="True" BorderThickness="0" Background="{DynamicResource Surface2}" Padding="12,10"
                   FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" Margin="0,0,0,14" />
          <WrapPanel>
            <Button Style="{StaticResource BtnSecondary}" Content="Copier le diagnostic" Click="CopyDiag_Click" Margin="0,0,8,8" />
            <Button Style="{StaticResource BtnSecondary}" Content="Quoi de neuf" Click="Changelog_Click" Margin="0,0,8,8" />
            <Button Style="{StaticResource BtnSecondary}" Content="Composants tiers et licences" Click="Licenses_Click" Margin="0,0,8,8" />
            <Button Style="{StaticResource BtnGhost}" Content="Ouvrir le dossier des données" Click="OpenData_Click" Margin="0,0,0,8" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
