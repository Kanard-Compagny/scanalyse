<UserControl x:Class="Scanalyse.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Paramètres par catégories : menu à gauche, une catégorie à la fois à droite (comme les réglages de GitHub ou Discord). -->
  <Grid Margin="28,22,28,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Style="{StaticResource PageTitle}" Text="Paramètres" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="Réglages de ce poste, de l'équipe et informations sur Scanalyse." Margin="0,4,0,18" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230" />
        <ColumnDefinition Width="28" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,16">
          <TextBlock Style="{StaticResource NavGroup}" Text="APPLICATION" />
          <RadioButton x:Name="NavGeneral" Style="{StaticResource SettingsNav}" Tag="{StaticResource IconSettings}" Content="Général" CommandParameter="SecGeneral" IsChecked="True" Checked="SettingsNav_Checked" />
          <RadioButton x:Name="NavUpdates" Style="{StaticResource SettingsNav}" Tag="{StaticResource IconRefresh}" Content="Mises à jour" CommandParameter="SecUpdates" Checked="SettingsNav_Checked" />
          <RadioButton x:Name="NavHelp" Style="{StaticResource SettingsNav}" Tag="{StaticResource IconHelp}" Content="Prise en main" CommandParameter="SecHelp" Checked="SettingsNav_Checked" />
          <RadioButton x:Name="NavPhone" Style="{StaticResource SettingsNav}" Tag="{StaticResource IconPhone}" Content="Sur téléphone" CommandParameter="SecPhone" Checked="SettingsNav_Checked" />
          <TextBlock Style="{StaticResource NavGroup}" Text="TRAVAIL" Margin="12,18,0,6" />
          <RadioButton x:Name="NavReports" Style="{StaticResource SettingsNav}" Tag="{StaticResource IconReport}" Content="Rapports PDF" CommandParameter="SecReports" Checked="SettingsNav_Checked" />
          <RadioButton x:Name="NavHistory" Style="{StaticResource SettingsNav}" Tag="{StaticResource IconHistory}" Content="Historique" CommandParameter="SecHistory" Checked="SettingsNav_Checked" />
          <RadioButton x:Name="NavPrint" Style="{StaticResource SettingsNav}" Tag="{StaticResource IconPrint}" Content="Impression et banc d'essai" CommandParameter="SecPrint" Checked="SettingsNav_Checked" />
          <RadioButton x:Name="NavTeam" Style="{StaticResource SettingsNav}" Tag="{StaticResource IconTeam}" Content="Profil d'équipe" CommandParameter="SecTeam" Checked="SettingsNav_Checked" />
          <TextBlock Style="{StaticResource NavGroup}" Text="SCANALYSE" Margin="12,18,0,6" />
          <RadioButton x:Name="NavAbout" Style="{StaticResource SettingsNav}" Tag="{StaticResource IconInfo}" Content="À propos" CommandParameter="SecAbout" Checked="SettingsNav_Checked" />
          <Border Height="1" Background="{DynamicResource Line}" Margin="10,14,10,10" />
          <RadioButton x:Name="NavUninstall" Style="{StaticResource SettingsNavDanger}" Tag="{StaticResource IconTrash}" Content="Désinstaller" CommandParameter="SecUninstall" Checked="SettingsNav_Checked" />
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="SectionScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Sections" MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,8,16">
        <StackPanel x:Name="SecGeneral">
          <TextBlock Style="{StaticResource SectionTitle}" Text="Général" />
          <TextBlock Style="{StaticResource PageSubtitle}" Text="Langue, apparence et ce qui s'affiche au démarrage." Margin="0,4,0,18" />
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="Langue / Language" />
              <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,12"
                         Text="Langue de l'interface. Le changement s'applique après le redémarrage de Scanalyse. / Interface language, applied after restarting Scanalyse." />
              <WrapPanel x:Name="LanguageChips">
                <RadioButton Style="{StaticResource Chip}" GroupName="Language" Tag="fr" Content="Français" Checked="Language_Checked" />
                <RadioButton Style="{StaticResource Chip}" GroupName="Language" Tag="en" Content="English" Checked="Language_Checked" />
              </WrapPanel>
              <Button x:Name="RestartButton" Style="{StaticResource BtnAction}" Content="Redémarrer maintenant / Restart now" Click="Restart_Click"
                      HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="Thème" />
              <TextBlock Style="{StaticResource PageSubtitle}" Text="Le choix est mémorisé. « Système » suit le réglage clair ou sombre de Windows." Margin="0,4,0,14" />
              <UniformGrid Columns="3">
                <RadioButton x:Name="ThemeSystem" Style="{StaticResource ChoiceCard}" GroupName="Theme" Margin="0,0,10,0" Checked="Theme_Checked">
                  <StackPanel>
                    <TextBlock Text="Système" FontWeight="SemiBold" />
                    <TextBlock Text="Comme Windows" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ThemeLight" Style="{StaticResource ChoiceCard}" GroupName="Theme" Margin="0,0,10,0" Checked="Theme_Checked">
                  <StackPanel>
                    <TextBlock Text="Clair" FontWeight="SemiBold" />
                    <TextBlock Text="Fond blanc, menu vert" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ThemeDark" Style="{StaticResource ChoiceCard}" GroupName="Theme" Checked="Theme_Checked">
                  <StackPanel>
                    <TextBlock Text="Sombre" FontWeight="SemiBold" />
                    <TextBlock Text="Pour les longues sessions" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                  </StackPanel>
                </RadioButton>
              </UniformGrid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="Démarrage et affichage" />
              <TextBlock Style="{StaticResource FieldLabel}" Text="Page ouverte au démarrage" Margin="0,12,0,6" />
              <WrapPanel x:Name="StartChips">
                <RadioButton Style="{StaticResource Chip}" GroupName="Start" Tag="analyse" Content="Analyser une image" Checked="Option_Changed" />
                <RadioButton Style="{StaticResource Chip}" GroupName="Start" Tag="create" Content="Créer un code" Checked="Option_Changed" />
                <RadioButton Style="{StaticResource Chip}" GroupName="Start" Tag="print" Content="Étiquette imprimante" Checked="Option_Changed" />
                <RadioButton Style="{StaticResource Chip}" GroupName="Start" Tag="config" Content="Conf imprimante" Checked="Option_Changed" />
                <RadioButton Style="{StaticResource Chip}" GroupName="Start" Tag="bench" Content="Banc d'essai" Checked="Option_Changed" />
                <RadioButton Style="{StaticResource Chip}" GroupName="Start" Tag="devices" Content="Appareils de lecture" Checked="Option_Changed" />
                <RadioButton Style="{StaticResource Chip}" GroupName="Start" Tag="history" Content="Historique" Checked="Option_Changed" />
              </WrapPanel>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Taille de l'interface" Margin="0,10,0,6" />
              <WrapPanel x:Name="ScaleChips">
                <RadioButton Style="{StaticResource Chip}" GroupName="Scale" Tag="1" Content="100 %" Checked="Option_Changed" />
                <RadioButton Style="{StaticResource Chip}" GroupName="Scale" Tag="1.15" Content="115 %" Checked="Option_Changed" />
                <RadioButton Style="{StaticResource Chip}" GroupName="Scale" Tag="1.3" Content="130 %" Checked="Option_Changed" />
              </WrapPanel>
              <CheckBox x:Name="LogOpenCheck" Style="{StaticResource CheckLine}" Content="Journal des lectures déplié au démarrage" Margin="0,10,0,0"
                        Checked="Option_Changed" Unchecked="Option_Changed" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="Ouvrir avec Scanalyse" />
              <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,12"
                         Text="Glisser un fichier sur Scanalyse.exe l'ouvre déjà au bon endroit : programme d'étiquette dans « Étiquette imprimante », image ou PDF dans « Analyser une image », profil d'équipe à l'import." />
              <CheckBox x:Name="OpenWithCheck" Style="{StaticResource CheckLine}" Click="OpenWith_Click"
                        Content="Proposer Scanalyse dans « Ouvrir avec » de l'Explorateur (.zpl, .prn, .txt, images, PDF) et ouvrir les profils d'équipe d'un double-clic" />
              <TextBlock FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                         Text="Pour ta session Windows uniquement, sans droits administrateur. Les programmes par défaut de ces fichiers ne changent pas. Retiré si tu décoches, ou par « Désinstaller »." />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="SecReports" Visibility="Collapsed">
          <TextBlock Style="{StaticResource SectionTitle}" Text="Rapports PDF" />
          <TextBlock Style="{StaticResource PageSubtitle}" Text="En-tête et dossier des rapports remis aux clients." Margin="0,4,0,18" />
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="En-tête des rapports" />
              <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,8"
                         Text="En-tête des rapports remis aux clients : ta société, ton nom et tes coordonnées, avec ton logo." />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="14" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Société" Margin="0,6,0,5" />
                  <TextBox x:Name="CompanyBox" Style="{StaticResource FieldInput}" LostFocus="Report_LostFocus" />
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Technicien (si le dossier n'en indique pas)" Margin="0,10,0,5" />
                  <TextBox x:Name="TechnicianBox" Style="{StaticResource FieldInput}" LostFocus="Report_LostFocus" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Coordonnées (téléphone, e-mail…)" Margin="0,6,0,5" />
                  <TextBox x:Name="ContactBox" Style="{StaticResource FieldInput}" LostFocus="Report_LostFocus" />
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Logo" Margin="0,10,0,5" />
                  <DockPanel>
                    <Button x:Name="LogoClear" DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="Retirer" Click="LogoClear_Click" Margin="6,0,0,0" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Content="Choisir…" Click="LogoPick_Click" Margin="8,0,0,0" />
                    <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="8,6" Height="40">
                      <DockPanel>
                        <Image x:Name="LogoPreview" DockPanel.Dock="Left" Height="26" MaxWidth="80" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="LogoName" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Text="Aucun" />
                      </DockPanel>
                    </Border>
                  </DockPanel>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="Dossier des rapports" />
              <TextBlock Style="{StaticResource FieldLabel}" Text="Dossier proposé à l'enregistrement d'un rapport" Margin="0,10,0,5" />
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                  <Button Style="{StaticResource BtnSecondary}" Content="Changer…" Click="PickReports_Click" Margin="0,0,8,0" />
                  <Button Style="{StaticResource BtnGhost}" Content="Ouvrir" Click="OpenReports_Click" />
                </StackPanel>
                <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="12,9">
                  <TextBlock x:Name="ReportsPath" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" />
                </Border>
              </DockPanel>

            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="SecHistory" Visibility="Collapsed">
          <TextBlock Style="{StaticResource SectionTitle}" Text="Historique" />
          <TextBlock Style="{StaticResource PageSubtitle}" Text="Enregistrement des analyses dans les dossiers SAV, durée de conservation et emplacement." Margin="0,4,0,18" />
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="Enregistrement des analyses" />
              <CheckBox x:Name="AutoRecordCheck" Style="{StaticResource CheckLine}" Margin="0,12,0,0" Checked="Option_Changed" Unchecked="Option_Changed"
                        Content="Enregistrer automatiquement chaque analyse et chaque comparaison dans le dossier SAV en cours" />
              <TextBlock Style="{StaticResource FieldLabel}" Text="Supprimer automatiquement les analyses plus anciennes que" Margin="0,12,0,6" />
              <WrapPanel x:Name="RetentionChips">
                <RadioButton Style="{StaticResource Chip}" GroupName="Retention" Tag="0" Content="Jamais" Checked="Option_Changed" />
                <RadioButton Style="{StaticResource Chip}" GroupName="Retention" Tag="30" Content="30 jours" Checked="Option_Changed" />
                <RadioButton Style="{StaticResource Chip}" GroupName="Retention" Tag="90" Content="3 mois" Checked="Option_Changed" />
                <RadioButton Style="{StaticResource Chip}" GroupName="Retention" Tag="180" Content="6 mois" Checked="Option_Changed" />
                <RadioButton Style="{StaticResource Chip}" GroupName="Retention" Tag="365" Content="1 an" Checked="Option_Changed" />
              </WrapPanel>
              <TextBlock FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                         Text="Appliqué à chaque démarrage. Les dossiers SAV et leurs fiches sont conservés, seules les analyses anciennes sont retirées." />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="Dossier de l'historique" />
              <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,12"
                         Text="Par défaut, l'historique est rangé à côté de Scanalyse.exe : il suit le programme (clé USB, dossier partagé). Choisis un dossier réseau pour que toute l'équipe partage les mêmes dossiers SAV." />
              <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="12,9" Margin="0,0,0,12">
                <TextBlock x:Name="HistoryPath" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" />
              </Border>
              <WrapPanel>
                <Button Style="{StaticResource BtnSecondary}" Content="Changer de dossier…" Click="ChangeHistory_Click" Margin="0,0,8,8" />
                <Button Style="{StaticResource BtnSecondary}" Content="Ouvrir le dossier" Click="OpenHistory_Click" Margin="0,0,8,8" />
                <Button x:Name="ResetHistoryButton" Style="{StaticResource BtnGhost}" Content="Revenir à côté du programme" Click="ResetHistory_Click" Margin="0,0,0,8" />
              </WrapPanel>

            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="SecPrint" Visibility="Collapsed">
          <TextBlock Style="{StaticResource SectionTitle}" Text="Impression et banc d'essai" />
          <TextBlock Style="{StaticResource PageSubtitle}" Text="Réglages par défaut du banc d'essai et de « Étiquette imprimante »." Margin="0,4,0,18" />
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="Banc d'essai" />
              <CheckBox x:Name="AutoCompareCheck" Style="{StaticResource CheckLine}" Margin="0,12,0,0" Checked="Option_Changed" Unchecked="Option_Changed"
                        Content="Comparer automatiquement chaque lecture reçue à la référence du banc d'essai" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="Étiquette imprimante" />
              <TextBlock Style="{StaticResource FieldLabel}" Text="Langage d'imprimante par défaut" Margin="0,12,0,6" />
              <WrapPanel x:Name="LangChips">
                <RadioButton Style="{StaticResource Chip}" GroupName="DefLang" Tag="Zpl" Content="ZPL II" Checked="Option_Changed" />
                <RadioButton Style="{StaticResource Chip}" GroupName="DefLang" Tag="Tspl" Content="TSPL" Checked="Option_Changed" />
                <RadioButton Style="{StaticResource Chip}" GroupName="DefLang" Tag="Epl2" Content="EPL2" Checked="Option_Changed" />
                <RadioButton Style="{StaticResource Chip}" GroupName="DefLang" Tag="Dpl" Content="DPL" Checked="Option_Changed" />
              </WrapPanel>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Résolution par défaut" Margin="0,10,0,6" />
              <WrapPanel x:Name="DpiChips">
                <RadioButton Style="{StaticResource Chip}" GroupName="DefDpi" Tag="203" Content="203 dpi" Checked="Option_Changed" />
                <RadioButton Style="{StaticResource Chip}" GroupName="DefDpi" Tag="300" Content="300 dpi" Checked="Option_Changed" />
                <RadioButton Style="{StaticResource Chip}" GroupName="DefDpi" Tag="600" Content="600 dpi" Checked="Option_Changed" />
              </WrapPanel>
              <TextBlock FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                         Text="L'imprimante (adresse IP ou imprimante Windows) et la taille d'étiquette utilisées en dernier sont retenues automatiquement." />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="Dossier des programmes d'étiquettes" />
              <TextBlock Style="{StaticResource FieldLabel}" Text="Dossier des programmes d'étiquettes (ouvrir les fichiers clients, enregistrer les ZPL)" Margin="0,10,0,5" />
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                  <Button Style="{StaticResource BtnSecondary}" Content="Changer…" Click="PickLabels_Click" Margin="0,0,8,0" />
                  <Button Style="{StaticResource BtnGhost}" Content="Ouvrir" Click="OpenLabels_Click" />
                </StackPanel>
                <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="12,9">
                  <TextBlock x:Name="LabelsPath" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" />
                </Border>
              </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="SecUpdates" Visibility="Collapsed">
          <TextBlock Style="{StaticResource SectionTitle}" Text="Mises à jour" />
          <TextBlock Style="{StaticResource PageSubtitle}" Text="Recherche des nouvelles versions de Scanalyse." Margin="0,4,0,18" />
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="Mises à jour" />
              <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,4,0,12"
                         Text="Scanalyse cherche une version plus récente dans le dossier de diffusion de l'équipe (partage réseau où l'on dépose le dernier Scanalyse.exe) et sur GitHub si le dépôt est public." />
              <CheckBox x:Name="UpdateCheckBox" Style="{StaticResource CheckLine}" Content="Rechercher au démarrage" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,0,0,10" />
              <TextBlock Style="{StaticResource FieldLabel}" Text="Dossier de diffusion de l'équipe" />
              <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="10,7" Margin="0,0,0,8">
                <TextBlock x:Name="UpdateFolderText" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink}" />
              </Border>
              <WrapPanel>
                <Button Style="{StaticResource BtnSecondary}" Content="Choisir…" Click="PickUpdateFolder_Click" Margin="0,0,8,8" />
                <Button x:Name="UpdateFolderClear" Style="{StaticResource BtnGhost}" Content="Retirer" Click="ClearUpdateFolder_Click" Margin="0,0,8,8" />
                <Button Style="{StaticResource BtnSecondary}" Content="Rechercher maintenant" Click="CheckUpdates_Click" Margin="0,0,0,8" />
              </WrapPanel>
              <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Muted}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="SecTeam" Visibility="Collapsed">
          <TextBlock Style="{StaticResource SectionTitle}" Text="Profil d'équipe" />
          <TextBlock Style="{StaticResource PageSubtitle}" Text="Configurer un nouveau poste en un clic." Margin="0,4,0,18" />
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="Profil d'équipe" />
              <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,4,0,12"
                         Text="Un seul fichier pour configurer un nouveau poste : en-tête et logo des rapports, dossiers partagés (historique, rapports, étiquettes, mises à jour), réglages d'impression et d'enregistrement. Le nom du technicien et la langue restent propres à chaque poste." />
              <WrapPanel>
                <Button Style="{StaticResource BtnSecondary}" Content="Exporter le profil…" Click="ExportProfile_Click" Margin="0,0,8,8" />
                <Button Style="{StaticResource BtnSecondary}" Content="Importer un profil…" Click="ImportProfile_Click" Margin="0,0,0,8" />
              </WrapPanel>
              <TextBlock x:Name="ProfileStatus" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Muted}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="SecHelp" Visibility="Collapsed">
          <TextBlock Style="{StaticResource SectionTitle}" Text="Prise en main" />
          <TextBlock Style="{StaticResource PageSubtitle}" Text="Revoir l'accueil ou la visite guidée." Margin="0,4,0,18" />
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="Prise en main" />
              <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,12"
                         Text="L'accueil présente Scanalyse et le choix des dossiers ; la visite guidée montre où se trouve chaque outil." />
              <WrapPanel>
                <Button Style="{StaticResource BtnSecondary}" Content="Revoir l'accueil" Click="Welcome_Click" Margin="0,0,8,8" />
                <Button Style="{StaticResource BtnSecondary}" Content="Lancer la visite guidée" Click="Tour_Click" Margin="0,0,8,8" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Version web pour téléphone : un QR code à scanner avec l'appareil photo -->
        <StackPanel x:Name="SecPhone" Visibility="Collapsed">
          <TextBlock Style="{StaticResource SectionTitle}" Text="Sur téléphone" />
          <TextBlock Style="{StaticResource PageSubtitle}" Text="Scanalyse dans la poche : lire et créer des codes sans le PC." Margin="0,4,0,18" />
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Background="White" CornerRadius="14" Padding="10" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Top">
                <Image Source="/Assets/app-qr.png" Width="200" Height="200" RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="QR code de la version téléphone de Scanalyse" />
              </Border>
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource CardTitle}" Text="Scanne ce code avec l'appareil photo du téléphone" TextWrapping="Wrap" />
                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Ink}"
                           Text="La version web de Scanalyse s'ouvre dans le navigateur, sur Android comme sur iPhone. Ajoute-la à l'écran d'accueil pour l'avoir comme une application : rien à installer depuis un store, et elle fonctionne même hors connexion." />
                <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource Muted}" LineHeight="21">
                  <Run Text="• Lire un code à la caméra, avec l'analyse détaillée" /><LineBreak />
                  <Run Text="• Créer un code et l'afficher en grand pour le faire scanner" /><LineBreak />
                  <Run Text="• Historique des lectures, gardé sur le téléphone" />
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12.5" Foreground="{DynamicResource Muted}"
                           Text="Comme sur le PC, rien n'est envoyé sur Internet : les images et les codes restent sur le téléphone." />
                <WrapPanel Margin="0,14,0,0">
                  <Button Style="{StaticResource BtnSecondary}" Content="Copier le lien" Click="CopyAppLink_Click" Margin="0,0,8,8" />
                  <Button Style="{StaticResource BtnSecondary}" Content="Ouvrir dans le navigateur" Click="OpenAppLink_Click" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBox x:Name="AppLinkBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                         Foreground="{DynamicResource Muted}" Text="https://kanard-compagny.github.io/scanalyse/app/" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <StackPanel x:Name="SecAbout" Visibility="Collapsed">
          <TextBlock Style="{StaticResource SectionTitle}" Text="À propos" />
          <TextBlock Style="{StaticResource PageSubtitle}" Text="Version, licence, crédits et diagnostic." Margin="0,4,0,18" />
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/logo-64.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource CardTitle}" Text="À propos de Scanalyse" />
                  <TextBlock x:Name="VersionText" Style="{StaticResource PageSubtitle}" Margin="0,2,0,0" />
                </StackPanel>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Margin="0,14,0,8"
                         Text="Toute l'analyse est faite sur ce PC : aucune image ni aucune donnée lue n'est envoyée sur Internet." />
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,14"
                         Text="Composants tiers : zxing-cpp (Apache 2.0), zxing-wasm et qr-code-styling (MIT), System.IO.Ports (MIT), Microsoft Edge WebView2." />
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,14"
                         Text="Logiciel libre et gratuit sous licence GNU GPL v3 : chacun peut l'utiliser, le partager et l'améliorer, à condition que ses versions restent libres. Fourni sans aucune garantie." />

              <!-- Crédits : badge et pseudo de l'auteur -->
              <Border Background="{DynamicResource Surface2}" CornerRadius="12" Padding="12,10" Margin="0,0,0,14" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <Image Source="/Assets/kanard-128.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                  <StackPanel Margin="12,0,4,0" VerticalAlignment="Center">
                    <TextBlock Text="Conçu et développé par" FontSize="11.5" Foreground="{DynamicResource Muted}" />
                    <TextBlock Text="Mr.Kanard" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Ink}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <WrapPanel>
                <Button Style="{StaticResource BtnSecondary}" Content="Quoi de neuf" Click="Changelog_Click" Margin="0,0,8,8" />
                <Button Style="{StaticResource BtnSecondary}" Content="Licence GPL v3" Click="License_Click" Margin="0,0,8,8" />
                <Button Style="{StaticResource BtnSecondary}" Content="Composants tiers et licences" Click="Licenses_Click" Margin="0,0,8,8" />
                <Button Style="{StaticResource BtnGhost}" Content="Ouvrir le dossier des données" Click="OpenData_Click" Margin="0,0,0,8" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="Diagnostic" />
              <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,12" Text="Versions et emplacements utiles à joindre à une demande d'aide (ticket GitHub, e-mail)." />
              <TextBox x:Name="DiagBox" IsReadOnly="True" BorderThickness="0" Background="{DynamicResource Surface2}" Padding="12,10"
                       FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" Margin="0,0,0,14" />
              <Button Style="{StaticResource BtnSecondary}" Content="Copier le diagnostic" Click="CopyDiag_Click" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="SecUninstall" Visibility="Collapsed">
          <TextBlock Style="{StaticResource SectionTitle}" Text="Désinstaller" />
          <TextBlock Style="{StaticResource PageSubtitle}" Text="Retirer Scanalyse de ce poste." Margin="0,4,0,18" />
          <Border Style="{StaticResource Card}" Margin="0,0,0,14" BorderBrush="{DynamicResource BadFg}">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="Désinstaller Scanalyse" />
              <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,4,0,12"
                         Text="Efface les réglages, le cache et, si tu le coches, tes données, puis ferme Scanalyse. L'Explorateur s'ouvre ensuite sur Scanalyse.exe et son dossier temporaire : il ne reste qu'à les supprimer (Suppr)." />
              <CheckBox x:Name="UninstallData" Style="{StaticResource CheckLine}" Margin="0,0,0,6" Click="UninstallData_Click">
                <TextBlock TextWrapping="Wrap" Text="Supprimer aussi mes données : historique des analyses, rapports PDF et programmes d'étiquettes enregistrés" />
              </CheckBox>
              <TextBlock x:Name="UninstallFolders" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="24,0,0,12" />
              <WrapPanel>
                <Button x:Name="UninstallButton" Style="{StaticResource BtnSecondary}" Content="Désinstaller…" Click="Uninstall_Click" Margin="0,0,8,0" />
                <Button x:Name="UninstallCancel" Style="{StaticResource BtnGhost}" Content="Annuler" Click="UninstallCancel_Click" Visibility="Collapsed" />
              </WrapPanel>
              <TextBlock x:Name="UninstallWarning" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource BadFg}" Visibility="Collapsed"
                         Text="Confirmer ? Les réglages (et les données cochées) seront effacés définitivement, puis Scanalyse se fermera." />
            </StackPanel>
          </Border>
        </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
