<UserControl x:Class="Scanalyse.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Scanalyse.Desktop">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,22,28,16" MaxWidth="1760" HorizontalAlignment="Stretch">
      <TextBlock Style="{StaticResource PageTitle}" Text="Paramètres" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="Apparence, dossiers de rangement, prise en main et informations sur le programme." Margin="0,4,0,20" />

      <!-- Cartes en colonnes selon la largeur de la fenêtre -->
      <local:MasonryPanel ColumnWidth="500" MaxColumns="3" Spacing="16">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="Thème" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Le choix est mémorisé. « Système » suit le réglage clair ou sombre de Windows." Margin="0,4,0,14" />
            <UniformGrid Columns="3">
              <RadioButton x:Name="ThemeSystem" Style="{StaticResource ChoiceCard}" GroupName="Theme" Margin="0,0,10,0" Checked="Theme_Checked">
                <StackPanel>
                  <TextBlock Text="Système" FontWeight="SemiBold" />
                  <TextBlock Text="Comme Windows" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ThemeLight" Style="{StaticResource ChoiceCard}" GroupName="Theme" Margin="0,0,10,0" Checked="Theme_Checked">
                <StackPanel>
                  <TextBlock Text="Clair" FontWeight="SemiBold" />
                  <TextBlock Text="Fond blanc, menu vert" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ThemeDark" Style="{StaticResource ChoiceCard}" GroupName="Theme" Checked="Theme_Checked">
                <StackPanel>
                  <TextBlock Text="Sombre" FontWeight="SemiBold" />
                  <TextBlock Text="Pour les longues sessions" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                </StackPanel>
              </RadioButton>
            </UniformGrid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="Langue / Language" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,12"
                       Text="Langue de l'interface. Le changement s'applique après le redémarrage de Scanalyse. / Interface language, applied after restarting Scanalyse." />
            <WrapPanel x:Name="LanguageChips">
              <RadioButton Style="{StaticResource Chip}" GroupName="Language" Tag="fr" Content="Français" Checked="Language_Checked" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Language" Tag="en" Content="English" Checked="Language_Checked" />
            </WrapPanel>
            <Button x:Name="RestartButton" Style="{StaticResource BtnAction}" Content="Redémarrer maintenant / Restart now" Click="Restart_Click"
                    HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="Démarrage et affichage" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Page ouverte au démarrage" Margin="0,12,0,6" />
            <WrapPanel x:Name="StartChips">
              <RadioButton Style="{StaticResource Chip}" GroupName="Start" Tag="analyse" Content="Analyser une image" Checked="Option_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Start" Tag="create" Content="Créer un code" Checked="Option_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Start" Tag="print" Content="Code imprimante" Checked="Option_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Start" Tag="bench" Content="Banc d'essai" Checked="Option_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Start" Tag="devices" Content="Appareils de lecture" Checked="Option_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Start" Tag="history" Content="Historique" Checked="Option_Changed" />
            </WrapPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Taille de l'interface" Margin="0,10,0,6" />
            <WrapPanel x:Name="ScaleChips">
              <RadioButton Style="{StaticResource Chip}" GroupName="Scale" Tag="1" Content="100 %" Checked="Option_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Scale" Tag="1.15" Content="115 %" Checked="Option_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Scale" Tag="1.3" Content="130 %" Checked="Option_Changed" />
            </WrapPanel>
            <CheckBox x:Name="LogOpenCheck" Style="{StaticResource CheckLine}" Content="Journal des lectures déplié au démarrage" Margin="0,10,0,0"
                      Checked="Option_Changed" Unchecked="Option_Changed" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="Rapports PDF" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,8"
                       Text="En-tête des rapports remis aux clients : ta société, ton nom et tes coordonnées, avec ton logo." />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Société" Margin="0,6,0,5" />
                <TextBox x:Name="CompanyBox" Style="{StaticResource FieldInput}" LostFocus="Report_LostFocus" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Technicien (si le dossier n'en indique pas)" Margin="0,10,0,5" />
                <TextBox x:Name="TechnicianBox" Style="{StaticResource FieldInput}" LostFocus="Report_LostFocus" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Coordonnées (téléphone, e-mail…)" Margin="0,6,0,5" />
                <TextBox x:Name="ContactBox" Style="{StaticResource FieldInput}" LostFocus="Report_LostFocus" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Logo" Margin="0,10,0,5" />
                <DockPanel>
                  <Button x:Name="LogoClear" DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="Retirer" Click="LogoClear_Click" Margin="6,0,0,0" />
                  <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Content="Choisir…" Click="LogoPick_Click" Margin="8,0,0,0" />
                  <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="8,6" Height="40">
                    <DockPanel>
                      <Image x:Name="LogoPreview" DockPanel.Dock="Left" Height="26" MaxWidth="80" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                      <TextBlock x:Name="LogoName" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Text="Aucun" />
                    </DockPanel>
                  </Border>
                </DockPanel>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="Enregistrement des analyses" />
            <CheckBox x:Name="AutoRecordCheck" Style="{StaticResource CheckLine}" Margin="0,12,0,0" Checked="Option_Changed" Unchecked="Option_Changed"
                      Content="Enregistrer automatiquement chaque analyse et chaque comparaison dans le dossier SAV en cours" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Supprimer automatiquement les analyses plus anciennes que" Margin="0,12,0,6" />
            <WrapPanel x:Name="RetentionChips">
              <RadioButton Style="{StaticResource Chip}" GroupName="Retention" Tag="0" Content="Jamais" Checked="Option_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Retention" Tag="30" Content="30 jours" Checked="Option_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Retention" Tag="90" Content="3 mois" Checked="Option_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Retention" Tag="180" Content="6 mois" Checked="Option_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Retention" Tag="365" Content="1 an" Checked="Option_Changed" />
            </WrapPanel>
            <TextBlock FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Appliqué à chaque démarrage. Les dossiers SAV et leurs fiches sont conservés, seules les analyses anciennes sont retirées." />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="Banc d'essai et impression" />
            <CheckBox x:Name="AutoCompareCheck" Style="{StaticResource CheckLine}" Margin="0,12,0,0" Checked="Option_Changed" Unchecked="Option_Changed"
                      Content="Comparer automatiquement chaque lecture reçue à la référence du banc d'essai" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Langage d'imprimante par défaut (Code imprimante)" Margin="0,12,0,6" />
            <WrapPanel x:Name="LangChips">
              <RadioButton Style="{StaticResource Chip}" GroupName="DefLang" Tag="Zpl" Content="ZPL II" Checked="Option_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="DefLang" Tag="Tspl" Content="TSPL" Checked="Option_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="DefLang" Tag="Epl2" Content="EPL2" Checked="Option_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="DefLang" Tag="Dpl" Content="DPL" Checked="Option_Changed" />
            </WrapPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Résolution par défaut" Margin="0,10,0,6" />
            <WrapPanel x:Name="DpiChips">
              <RadioButton Style="{StaticResource Chip}" GroupName="DefDpi" Tag="203" Content="203 dpi" Checked="Option_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="DefDpi" Tag="300" Content="300 dpi" Checked="Option_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="DefDpi" Tag="600" Content="600 dpi" Checked="Option_Changed" />
            </WrapPanel>
            <TextBlock FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="L'imprimante (adresse IP ou imprimante Windows) et la taille d'étiquette utilisées en dernier sont retenues automatiquement." />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="Dossiers de rangement" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,12"
                       Text="Par défaut, l'historique est rangé à côté de Scanalyse.exe : il suit le programme (clé USB, dossier partagé). Choisis un dossier réseau pour que toute l'équipe partage les mêmes dossiers SAV." />
            <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="12,9" Margin="0,0,0,12">
              <TextBlock x:Name="HistoryPath" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" />
            </Border>
            <WrapPanel>
              <Button Style="{StaticResource BtnSecondary}" Content="Changer de dossier…" Click="ChangeHistory_Click" Margin="0,0,8,8" />
              <Button Style="{StaticResource BtnSecondary}" Content="Ouvrir le dossier" Click="OpenHistory_Click" Margin="0,0,8,8" />
              <Button x:Name="ResetHistoryButton" Style="{StaticResource BtnGhost}" Content="Revenir à côté du programme" Click="ResetHistory_Click" Margin="0,0,0,8" />
            </WrapPanel>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Dossier proposé pour enregistrer les rapports PDF" Margin="0,14,0,5" />
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Style="{StaticResource BtnSecondary}" Content="Changer…" Click="PickReports_Click" Margin="0,0,8,0" />
                <Button Style="{StaticResource BtnGhost}" Content="Ouvrir" Click="OpenReports_Click" />
              </StackPanel>
              <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="12,9">
                <TextBlock x:Name="ReportsPath" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" />
              </Border>
            </DockPanel>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Dossier des programmes d'étiquettes (ouvrir les fichiers clients, enregistrer les ZPL)" Margin="0,14,0,5" />
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Style="{StaticResource BtnSecondary}" Content="Changer…" Click="PickLabels_Click" Margin="0,0,8,0" />
                <Button Style="{StaticResource BtnGhost}" Content="Ouvrir" Click="OpenLabels_Click" />
              </StackPanel>
              <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="12,9">
                <TextBlock x:Name="LabelsPath" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" />
              </Border>
            </DockPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="Prise en main" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,12"
                       Text="L'accueil présente Scanalyse et le choix des dossiers ; la visite guidée montre où se trouve chaque outil." />
            <WrapPanel>
              <Button Style="{StaticResource BtnSecondary}" Content="Revoir l'accueil" Click="Welcome_Click" Margin="0,0,8,8" />
              <Button Style="{StaticResource BtnSecondary}" Content="Lancer la visite guidée" Click="Tour_Click" Margin="0,0,8,8" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Image Source="/Assets/logo-64.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
              <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource CardTitle}" Text="À propos de Scanalyse" />
                <TextBlock x:Name="VersionText" Style="{StaticResource PageSubtitle}" Margin="0,2,0,0" />
              </StackPanel>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Margin="0,14,0,8"
                       Text="Toute l'analyse est faite sur ce PC : aucune image ni aucune donnée lue n'est envoyée sur Internet." />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,14"
                       Text="Composants tiers : zxing-cpp (Apache 2.0), zxing-wasm et qr-code-styling (MIT), System.IO.Ports (MIT), Microsoft Edge WebView2." />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Diagnostic (à joindre à une demande d'aide)" />
            <TextBox x:Name="DiagBox" IsReadOnly="True" BorderThickness="0" Background="{DynamicResource Surface2}" Padding="12,10"
                     FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" Margin="0,0,0,14" />
            <WrapPanel>
              <Button Style="{StaticResource BtnSecondary}" Content="Copier le diagnostic" Click="CopyDiag_Click" Margin="0,0,8,8" />
              <Button Style="{StaticResource BtnSecondary}" Content="Quoi de neuf" Click="Changelog_Click" Margin="0,0,8,8" />
              <Button Style="{StaticResource BtnSecondary}" Content="Composants tiers et licences" Click="Licenses_Click" Margin="0,0,8,8" />
              <Button Style="{StaticResource BtnGhost}" Content="Ouvrir le dossier des données" Click="OpenData_Click" Margin="0,0,0,8" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="Désinstaller Scanalyse" />
            <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,4,0,12"
                       Text="Efface les réglages, le cache et, si tu le coches, tes données, puis ferme Scanalyse. L'Explorateur s'ouvre ensuite sur Scanalyse.exe et son dossier temporaire : il ne reste qu'à les supprimer (Suppr)." />
            <CheckBox x:Name="UninstallData" Style="{StaticResource CheckLine}" Margin="0,0,0,6" Click="UninstallData_Click">
              <TextBlock TextWrapping="Wrap" Text="Supprimer aussi mes données : historique des analyses, rapports PDF et programmes d'étiquettes enregistrés" />
            </CheckBox>
            <TextBlock x:Name="UninstallFolders" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="24,0,0,12" />
            <WrapPanel>
              <Button x:Name="UninstallButton" Style="{StaticResource BtnSecondary}" Content="Désinstaller…" Click="Uninstall_Click" Margin="0,0,8,0" />
              <Button x:Name="UninstallCancel" Style="{StaticResource BtnGhost}" Content="Annuler" Click="UninstallCancel_Click" Visibility="Collapsed" />
            </WrapPanel>
            <TextBlock x:Name="UninstallWarning" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource BadFg}" Visibility="Collapsed"
                       Text="Confirmer ? Les réglages (et les données cochées) seront effacés définitivement, puis Scanalyse se fermera." />
          </StackPanel>
        </Border>
      </local:MasonryPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
