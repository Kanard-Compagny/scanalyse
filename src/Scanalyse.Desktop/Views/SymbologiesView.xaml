<UserControl x:Class="Scanalyse.Desktop.Views.SymbologiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Scanalyse.Desktop.Views">
  <Grid Margin="28,22,28,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,18">
      <TextBlock Style="{StaticResource PageTitle}" Text="Symbologies" />
      <TextBlock Style="{StaticResource PageSubtitle}"
                 Text="Fiche de référence de chaque type de code : ce qu'il sait encoder, sa capacité, ses usages et sa norme." />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="List">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type views:SymbologyCard}">
            <Border Style="{StaticResource Card}" Width="380" Margin="0,0,16,16">
              <StackPanel>
                <WrapPanel Margin="0,0,0,12">
                  <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}" Margin="0,0,10,0" VerticalAlignment="Center" />
                  <Border Style="{StaticResource Pill}" Margin="0,0,6,0">
                    <TextBlock Text="{Binding Family}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                  </Border>
                  <Border Style="{StaticResource Pill}" Background="{DynamicResource BrandSoft}" Visibility="{Binding Gs1Visibility}">
                    <TextBlock Text="GS1" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrandText}" />
                  </Border>
                </WrapPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Caractères" Margin="0" />
                <TextBlock Text="{Binding CharacterSet}" TextWrapping="Wrap" Margin="0,2,0,10" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Capacité" Margin="0" />
                <TextBlock Text="{Binding Capacity}" TextWrapping="Wrap" Margin="0,2,0,10" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Usages typiques" Margin="0" />
                <TextBlock Text="{Binding TypicalUses}" TextWrapping="Wrap" Margin="0,2,0,10" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Norme" Margin="0" />
                    <TextBlock Text="{Binding Standard}" TextWrapping="Wrap" Margin="0,2,8,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Zone de silence" Margin="0" />
                    <TextBlock Text="{Binding QuietZone}" TextWrapping="Wrap" Margin="0,2,0,0" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
