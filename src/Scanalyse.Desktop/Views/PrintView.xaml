<UserControl x:Class="Scanalyse.Desktop.Views.PrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" PreviewDragOver="Root_DragOver" PreviewDrop="Root_Drop">
  <UserControl.Resources>
    <Style x:Key="Unit" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <!-- Titre de section numéroté : les réglages se lisent comme des étapes -->
    <Style x:Key="Step" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Margin" Value="0,18,0,8" />
    </Style>
    <Style x:Key="Num" TargetType="TextBox" BasedOn="{StaticResource FieldInput}">
      <Setter Property="Width" Value="72" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
  </UserControl.Resources>

<ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="28,22,28,16">
  <!-- Hauteur de la fenêtre si elle suffit, sinon hauteur minimale et défilement : rien n'est jamais coupé. -->
  <Grid x:Name="PageGrid" SizeChanged="PageGrid_SizeChanged" MinHeight="850" Height="{Binding ViewportHeight, ElementName=PageScroll}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- En-tête : titre à gauche, choix à droite ; sous le titre quand la fenêtre est étroite (voir PageGrid_SizeChanged) -->
    <Grid x:Name="HeaderGrid" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="260" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Code imprimante" />
        <TextBlock x:Name="PageSubtitle" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                   Text="Génère le programme ZPL, TSPL, EPL2 ou DPL d'une étiquette pour recréer le code d'un client sur son imprimante, et l'envoie directement." />
      </StackPanel>
      <WrapPanel x:Name="HeaderChips" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
        <!-- Ce qu'on affiche à droite : l'aperçu, le programme, ou les deux l'un sous l'autre -->
        <WrapPanel x:Name="ViewChips" VerticalAlignment="Center">
          <TextBlock Text="Afficher" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,6" />
          <RadioButton x:Name="ViewPreview" Style="{StaticResource Chip}" GroupName="PaneView" Content="Aperçu" Checked="View_Changed"
                       ToolTip="L'étiquette en grand" />
          <RadioButton x:Name="ViewProgram" Style="{StaticResource Chip}" GroupName="PaneView" Content="Programme" Checked="View_Changed"
                       ToolTip="Le code en grand" />
          <RadioButton x:Name="ViewBoth" Style="{StaticResource Chip}" GroupName="PaneView" Content="Les deux" IsChecked="True" Checked="View_Changed"
                       ToolTip="L'aperçu au-dessus du programme" />
        </WrapPanel>
        <Rectangle Width="1" Height="26" Fill="{DynamicResource Line}" Margin="10,0,16,6" VerticalAlignment="Center" />
        <RadioButton x:Name="ModeCreate" Style="{StaticResource Chip}" GroupName="PageMode" Content="Créer une étiquette" IsChecked="True" Checked="PageMode_Changed" />
        <RadioButton x:Name="ModeTemplate" Style="{StaticResource Chip}" GroupName="PageMode" Content="Modèles" Checked="PageMode_Changed"
                     ToolTip="Étiquettes prêtes à l'emploi : palette GS1 (SSCC), colis, produit, emplacement, inventaire" />
        <RadioButton x:Name="ModeRead" Style="{StaticResource Chip}" GroupName="PageMode" Content="Lire un programme" Checked="PageMode_Changed"
                     ToolTip="Colle le programme d'un client : aperçu de l'étiquette, codes-barres et ce qu'ils contiennent, points à corriger" />
      </WrapPanel>
    </Grid>

    <!-- Imprimante : toujours au même endroit, en haut de la page -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,14">
      <StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnAction}" Content="Envoyer à l'imprimante" Click="Send_Click" Margin="12,0,0,0" VerticalAlignment="Center" />
          <TextBlock DockPanel.Dock="Left" Text="Imprimante" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
            <RadioButton x:Name="ModeTcp" Style="{StaticResource Chip}" GroupName="Target" Content="Réseau (IP, port 9100)" IsChecked="True" Checked="Mode_Changed" Margin="0,0,6,0" />
            <RadioButton x:Name="ModeQueue" Style="{StaticResource Chip}" GroupName="Target" Content="Installée sur ce PC" Checked="Mode_Changed" Margin="0,0,0,0" />
          </StackPanel>
          <Grid VerticalAlignment="Center">
              <DockPanel x:Name="AddressPanel" Margin="0">
                <Grid>
                  <TextBox x:Name="AddressBox" Style="{StaticResource FieldInput}" />
                  <TextBlock x:Name="AddressHint" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Muted}" FontSize="13"
                             Text="ex. 192.168.1.50 ou 192.168.1.50:6101" />
                </Grid>
              </DockPanel>
              <StackPanel x:Name="QueuePanel" Visibility="Collapsed" Margin="0">
                <Button x:Name="QueueButton" Style="{StaticResource BtnSecondary}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="QueueButton_Click"
                        ToolTip="Choisir l'imprimante (les données partent en mode RAW : le pilote ne les modifie pas)">
                  <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right" Text="▾" FontSize="14" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock x:Name="QueueCount" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock x:Name="QueueSelected" Text="Choisir une imprimante…" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </DockPanel>
                </Button>
                <Popup x:Name="QueuePopup" PlacementTarget="{Binding ElementName=QueueButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       Width="{Binding ActualWidth, ElementName=QueueButton}" PopupAnimation="Fade">
                  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,6,0,0">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="Actualiser" Click="RefreshQueues_Click" Padding="8,2" Margin="8,0,0,0" />
                        <Grid>
                          <TextBox x:Name="QueueSearch" Style="{StaticResource FieldInput}" TextChanged="QueueSearch_TextChanged" />
                          <TextBlock x:Name="QueueSearchHint" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Muted}" FontSize="13"
                                     Text="Rechercher (nom, serveur…)" />
                        </Grid>
                      </DockPanel>
                      <ScrollViewer x:Name="QueueScroll" MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="QueueChips" />
                      </ScrollViewer>
                      <TextBlock x:Name="QueueHint" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                 Text="Les données partent en mode RAW : le pilote ne les modifie pas (pilote Zebra, Honeywell, TSC… ou « Generic / Text Only »)." />
                    </StackPanel>
                  </Border>
                </Popup>
              </StackPanel>
          </Grid>
        </DockPanel>
        <TextBlock x:Name="SendStatus" FontSize="12.5" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,6,0,0" />
        <!-- Maintenance : état, calibrage, page de configuration, redémarrage -->
        <WrapPanel Margin="0,8,0,0">
          <TextBlock Text="Maintenance" FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <WrapPanel x:Name="ToolLangChips" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Langage que parle l'imprimante">
            <RadioButton Style="{StaticResource Chip}" GroupName="ToolLang" Tag="Zpl" Content="ZPL" IsChecked="True" />
            <RadioButton Style="{StaticResource Chip}" GroupName="ToolLang" Tag="Tspl" Content="TSPL" />
            <RadioButton Style="{StaticResource Chip}" GroupName="ToolLang" Tag="Epl2" Content="EPL2" />
            <RadioButton Style="{StaticResource Chip}" GroupName="ToolLang" Tag="Dpl" Content="DPL" />
          </WrapPanel>
          <Button Style="{StaticResource BtnGhost}" Tag="Status" Content="Lire l'état" Click="PrinterTool_Click"
                  ToolTip="Papier, ruban, tête ouverte, pause… (imprimante en réseau : la réponse ne revient pas par USB)" />
          <Button Style="{StaticResource BtnGhost}" Tag="Calibrate" Content="Calibrer" Click="PrinterTool_Click"
                  ToolTip="Mesure des étiquettes (espace ou marque noire) : quelques étiquettes avancent" />
          <Button Style="{StaticResource BtnGhost}" Tag="ConfigLabel" Content="Page de configuration" Click="PrinterTool_Click"
                  ToolTip="Imprime l'étiquette de configuration de l'imprimante (réglages, réseau, firmware)" />
          <Button Style="{StaticResource BtnGhost}" Tag="Reset" Content="Redémarrer" Click="PrinterTool_Click"
                  ToolTip="Redémarrage logiciel : les réglages enregistrés sont conservés" />
        </WrapPanel>
        <StackPanel x:Name="ToolResult" Margin="0,6,0,0" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="6*" />
      </Grid.ColumnDefinitions>

      <!-- Contenu et étiquette -->
      <Border x:Name="SettingsCard" Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-8,0" Padding="0,0,8,0">
          <StackPanel>
            <TextBlock Style="{StaticResource Step}" Text="1 · Contenu du code" Margin="0,0,0,2" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Accepte &lt;GS&gt;, &lt;RS&gt;… et la forme « (01)… » pour GS1" />
            <TextBlock x:Name="SourceText" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource BrandText}" FontWeight="SemiBold" Visibility="Collapsed" />
            <TextBox x:Name="DataBox" Style="{StaticResource Input}" AcceptsReturn="False" MinHeight="64" TextWrapping="Wrap" TextChanged="Any_Changed" />

            <TextBlock Style="{StaticResource Step}" Text="2 · Type de code" />
            <WrapPanel x:Name="SymChips">
              <RadioButton Style="{StaticResource Chip}" GroupName="Sym" Tag="Code128" Content="Code 128" IsChecked="True" Checked="Any_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Sym" Tag="Gs1_128" Content="GS1-128" Checked="Any_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Sym" Tag="Ean13" Content="EAN-13" Checked="Any_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Sym" Tag="Ean8" Content="EAN-8" Checked="Any_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Sym" Tag="UpcA" Content="UPC-A" Checked="Any_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Sym" Tag="Code39" Content="Code 39" Checked="Any_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Sym" Tag="Itf" Content="ITF" Checked="Any_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Sym" Tag="QrCode" Content="QR Code" Checked="Any_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Sym" Tag="DataMatrix" Content="Data Matrix" Checked="Any_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Sym" Tag="Gs1DataMatrix" Content="GS1 DataMatrix" Checked="Any_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Sym" Tag="Pdf417" Content="PDF417" Checked="Any_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Sym" Tag="Aztec" Content="Aztec" Checked="Any_Changed" />
            </WrapPanel>

            <TextBlock Style="{StaticResource Step}" Text="3 · Imprimante : résolution de la tête" />
            <WrapPanel x:Name="DpiChips">
              <RadioButton Style="{StaticResource Chip}" GroupName="Dpi" Tag="203" Content="203 dpi (8 points/mm)" IsChecked="True" Checked="Any_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Dpi" Tag="300" Content="300 dpi (12 points/mm)" Checked="Any_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Dpi" Tag="600" Content="600 dpi (24 points/mm)" Checked="Any_Changed" />
            </WrapPanel>

            <TextBlock Style="{StaticResource Step}" Text="4 · Étiquette, position et taille du code" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="Largeur" VerticalAlignment="Center" Margin="0,0,10,0" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="WidthBox" Style="{StaticResource Num}" Text="100" TextChanged="Any_Changed" />
                <TextBlock Style="{StaticResource Unit}" Text="mm" />
              </StackPanel>
              <TextBlock Grid.Column="3" Text="Hauteur" VerticalAlignment="Center" Margin="0,0,10,0" />
              <StackPanel Grid.Column="4" Orientation="Horizontal">
                <TextBox x:Name="HeightBox" Style="{StaticResource Num}" Text="50" TextChanged="Any_Changed" />
                <TextBlock Style="{StaticResource Unit}" Text="mm" />
              </StackPanel>

              <TextBlock Grid.Row="2" Text="Depuis la gauche" VerticalAlignment="Center" Margin="0,0,10,0" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="XBox" Style="{StaticResource Num}" Text="5" TextChanged="Any_Changed" />
                <TextBlock Style="{StaticResource Unit}" Text="mm" />
              </StackPanel>
              <TextBlock Grid.Row="2" Grid.Column="3" Text="Depuis le haut" VerticalAlignment="Center" Margin="0,0,10,0" />
              <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal">
                <TextBox x:Name="YBox" Style="{StaticResource Num}" Text="5" TextChanged="Any_Changed" />
                <TextBlock Style="{StaticResource Unit}" Text="mm" />
              </StackPanel>

              <TextBlock Grid.Row="4" Text="Module" VerticalAlignment="Center" Margin="0,0,10,0"
                         ToolTip="Largeur de la barre la plus fine (1D) ou d'un carré (2D), en points de la tête" />
              <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="ModuleBox" Style="{StaticResource Num}" Text="3" TextChanged="Any_Changed" />
                <TextBlock x:Name="ModuleMm" Style="{StaticResource Unit}" Text="points" />
              </StackPanel>
              <TextBlock x:Name="BarsLabel" Grid.Row="4" Grid.Column="3" Text="Hauteur des barres" VerticalAlignment="Center" Margin="0,0,10,0" />
              <StackPanel x:Name="BarsPanel" Grid.Row="4" Grid.Column="4" Orientation="Horizontal">
                <TextBox x:Name="BarsBox" Style="{StaticResource Num}" Text="15" TextChanged="Any_Changed" />
                <TextBlock Style="{StaticResource Unit}" Text="mm" />
              </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource Step}" Text="5 · Rotation et texte" />
            <WrapPanel x:Name="RotChips">
              <RadioButton Style="{StaticResource Chip}" GroupName="Rot" Tag="0" Content="0°" IsChecked="True" Checked="Any_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Rot" Tag="90" Content="90°" Checked="Any_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Rot" Tag="180" Content="180°" Checked="Any_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="Rot" Tag="270" Content="270°" Checked="Any_Changed" />
            </WrapPanel>

            <CheckBox x:Name="HriCheck" Style="{StaticResource CheckLine}" Content="Texte lisible sous le code (codes 1D)" IsChecked="True" Margin="0,8,0,0"
                      Checked="Any_Changed" Unchecked="Any_Changed" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Texte libre sous le code (facultatif : référence, n° de dossier…)" Margin="0,12,0,5" />
            <TextBox x:Name="CaptionBox" Style="{StaticResource FieldInput}" TextChanged="Any_Changed" />

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <TextBlock Text="Exemplaires" VerticalAlignment="Center" Margin="0,0,10,0" />
              <TextBox x:Name="CopiesBox" Style="{StaticResource Num}" Text="1" TextChanged="Any_Changed" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Modèles d'étiquettes -->
      <Border x:Name="TemplateCard" Style="{StaticResource Card}" Visibility="Collapsed">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource CardTitle}" Text="Modèle d'étiquette" />
            <WrapPanel x:Name="TemplateChips" Margin="0,8,0,0" />
            <TextBlock x:Name="TemplateDescription" FontSize="12.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <WrapPanel x:Name="TemplateLangChips" Margin="0,10,0,0" ToolTip="Langage du programme produit : celui que parle l'imprimante du client">
              <RadioButton Style="{StaticResource Chip}" GroupName="TplLang" Tag="Zpl" Content="ZPL II" IsChecked="True" Checked="Template_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="TplLang" Tag="Tspl" Content="TSPL" Checked="Template_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="TplLang" Tag="Epl2" Content="EPL2" Checked="Template_Changed" />
              <RadioButton Style="{StaticResource Chip}" GroupName="TplLang" Tag="Dpl" Content="DPL" Checked="Template_Changed" />
            </WrapPanel>
            <WrapPanel Margin="0,6,0,0">
              <WrapPanel x:Name="TemplateDpiChips" Margin="0,0,12,0">
                <RadioButton Style="{StaticResource Chip}" GroupName="TplDpi" Tag="203" Content="203 dpi" IsChecked="True" Checked="Template_Changed" />
                <RadioButton Style="{StaticResource Chip}" GroupName="TplDpi" Tag="300" Content="300 dpi" Checked="Template_Changed" />
                <RadioButton Style="{StaticResource Chip}" GroupName="TplDpi" Tag="600" Content="600 dpi" Checked="Template_Changed" />
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Exemplaires" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="TemplateCopies" Style="{StaticResource Num}" Text="1" TextChanged="Template_Changed" />
              </StackPanel>
            </WrapPanel>
          </StackPanel>
          <StackPanel x:Name="TemplateWarnings" DockPanel.Dock="Bottom" Margin="0,8,0,0" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-8,0" Padding="0,0,8,0">
            <StackPanel x:Name="TemplateFields" />
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Lecture d'un programme ZPL -->
      <Border x:Name="ReadCard" Style="{StaticResource Card}" Visibility="Collapsed">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource CardTitle}" Text="Contenu du programme" />
            <WrapPanel x:Name="ReadDpiChips" Margin="0,8,0,0">
                <RadioButton Style="{StaticResource Chip}" GroupName="ReadDpi" Tag="203" Content="203 dpi" IsChecked="True" Checked="ReadDpi_Changed" />
                <RadioButton Style="{StaticResource Chip}" GroupName="ReadDpi" Tag="300" Content="300 dpi" Checked="ReadDpi_Changed" />
                <RadioButton Style="{StaticResource Chip}" GroupName="ReadDpi" Tag="600" Content="600 dpi" Checked="ReadDpi_Changed" />
              </WrapPanel>
            <TextBlock x:Name="ReadSummary" FontSize="12.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
          <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button Style="{StaticResource BtnSecondary}" Content="Ouvrir un fichier…" Click="OpenProgram_Click" Margin="0,0,8,0"
                    ToolTip="Fichier .zpl, .prn ou .txt envoyé par le client (tu peux aussi le glisser sur la page)" />
            <Button Style="{StaticResource BtnSecondary}" Content="Analyse complète de l'étiquette" Click="AnalyzeLabel_Click" Margin="0,0,8,0"
                    ToolTip="Envoie l'aperçu dans « Analyser une image » : fiche de chaque code, cohérence GS1 de l'étiquette, historique et rapport" />
          </WrapPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-8,0" Padding="0,0,8,0">
            <StackPanel x:Name="ReadPanel" />
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Aperçu + programme -->
      <Grid x:Name="RightPane" Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="PreviewCard" Style="{StaticResource Card}" Margin="0,0,0,14">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <DockPanel>
                <TextBlock x:Name="PreviewInfo" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock Style="{StaticResource CardTitle}" Text="Aperçu de l'étiquette" />
              </DockPanel>
              <WrapPanel Margin="0,6,0,0">
              <StackPanel x:Name="ZplTools" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,10,0">
                <Button Style="{StaticResource BtnGhost}" Content="↺" Click="RotateLeft_Click" Padding="9,2" FontSize="15" ToolTip="Pivoter l'aperçu d'un quart de tour à gauche" />
                <Button Style="{StaticResource BtnGhost}" Content="↻" Click="RotateRight_Click" Padding="9,2" FontSize="15" ToolTip="Pivoter l'aperçu d'un quart de tour à droite" />
                <Rectangle Width="1" Height="18" Fill="{DynamicResource Line}" Margin="6,0" />
                <Button Style="{StaticResource BtnGhost}" Content="−" Click="ZoomOut_Click" Padding="9,2" FontSize="15" ToolTip="Dézoomer (Ctrl + molette)" />
                <Button x:Name="ZoomFitButton" Style="{StaticResource BtnGhost}" Content="Ajuster" Click="ZoomFit_Click" Padding="8,2" ToolTip="Toute l'étiquette dans le cadre" />
                <Button Style="{StaticResource BtnGhost}" Content="+" Click="ZoomIn_Click" Padding="9,2" FontSize="15" ToolTip="Zoomer (Ctrl + molette)" />
              </StackPanel>
              <Button x:Name="ExpandPreviewButton" Style="{StaticResource BtnGhost}" Content="Agrandir" Click="ExpandPreview_Click" Margin="0" Padding="8,2"
                      ToolTip="Affiche l'aperçu sur toute la page (Échap pour revenir)" />
              </WrapPanel>
            </StackPanel>
            <TextBlock x:Name="PreviewNote" DockPanel.Dock="Bottom" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Aperçu indicatif, dessiné par Scanalyse : le rendu final dépend du firmware de l'imprimante." />
            <Border x:Name="PreviewBox" Margin="0,10,0,0" Height="170" Background="{DynamicResource Surface2}" CornerRadius="10" Padding="14">
              <Grid>
                <Viewbox x:Name="CreateViewbox" Stretch="Uniform" StretchDirection="Both">
                  <Border BorderBrush="#33000000" BorderThickness="1" Background="White" CornerRadius="3">
                    <Canvas x:Name="LabelCanvas" Width="400" Height="200" ClipToBounds="True">
                      <Image x:Name="CodeImage" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill" />
                      <TextBlock x:Name="CaptionPreview" Foreground="Black" FontFamily="Arial" />
                    </Canvas>
                  </Border>
                </Viewbox>
                <ScrollViewer x:Name="ZplScroll" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False"
                              PreviewMouseWheel="ZplScroll_Wheel" SizeChanged="ZplScroll_SizeChanged">
                  <Border x:Name="ZplFrame" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#33000000" BorderThickness="1" Background="White"
                          Cursor="Hand" MouseLeftButtonUp="ZplFrame_Click" ToolTip="Clique sur un élément de l'étiquette pour voir sa ligne et son détail">
                    <Grid>
                      <Image x:Name="ZplImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality" />
                      <Canvas x:Name="ZplOverlay" IsHitTestVisible="False" />
                    </Grid>
                  </Border>
                </ScrollViewer>
                <StackPanel x:Name="ZplEmptyBox" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                  <TextBlock x:Name="ZplEmpty" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource Muted}" Text="Colle le programme ZPL du client dans la zone « Programme » : l'étiquette s'affiche ici." />
                  <WrapPanel x:Name="ZplEmptyActions" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Button Style="{StaticResource BtnSecondary}" Content="Coller un programme client" Click="PasteProgram_Click" Margin="0,0,8,8" />
                    <Button Style="{StaticResource BtnSecondary}" Content="Ouvrir un fichier…" Click="OpenProgram_Click" Margin="0,0,8,8" />
                    <Button Style="{StaticResource BtnGhost}" Content="Partir d'un modèle" Click="GoTemplates_Click" Margin="0,0,0,8" />
                  </WrapPanel>
                </StackPanel>
              </Grid>
            </Border>
          </DockPanel>
        </Border>

        <Border x:Name="ProgramCard" Grid.Row="1" Style="{StaticResource Card}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ProgramTitle" Style="{StaticResource CardTitle}" Text="Programme ZPL" />
                <TextBlock x:Name="ProgramHint" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Généré depuis les réglages. Tu peux modifier les lignes directement, ou coller le programme d'un client pour le lire." />
              </StackPanel>
              <WrapPanel Margin="0,8,0,0">
              <WrapPanel x:Name="LangChips">
                <RadioButton Style="{StaticResource Chip}" GroupName="Lang" Tag="Zpl" Content="ZPL II" IsChecked="True" Checked="Any_Changed"
                             ToolTip="Zebra, et la plupart des imprimantes en émulation ZPL (Honeywell, SATO, TSC, Citizen…)" />
                <RadioButton Style="{StaticResource Chip}" GroupName="Lang" Tag="Tspl" Content="TSPL" Checked="Any_Changed"
                             ToolTip="TSC et nombreuses imprimantes d'entrée de gamme" />
                <RadioButton Style="{StaticResource Chip}" GroupName="Lang" Tag="Epl2" Content="EPL2" Checked="Any_Changed"
                             ToolTip="Anciennes Zebra (LP/TLP 2844…), codes 1D" />
                <RadioButton Style="{StaticResource Chip}" GroupName="Lang" Tag="Dpl" Content="DPL" Checked="Any_Changed"
                             ToolTip="Honeywell / Datamax (I-Class, H-Class, M-Class, E-Class…) : codes 1D, QR Code, Data Matrix" />
              </WrapPanel>
              <Button Style="{StaticResource BtnGhost}" Content="Ouvrir un fichier…" Click="OpenProgram_Click" Margin="0,0,12,6"
                      VerticalAlignment="Center" ToolTip="Ouvre un fichier du PC (.zpl, .prn, .txt, .epl…) : le programme s'affiche en lecture. Tu peux aussi glisser le fichier sur la page." />
              <Button x:Name="PasteProgramButton" Style="{StaticResource BtnGhost}" Content="Coller un programme client" Click="PasteProgram_Click" Margin="0,0,12,6"
                      VerticalAlignment="Center" ToolTip="Colle le programme du presse-papiers (ZPL, TSPL, EPL2…) et l'affiche en lecture" />
              <Button x:Name="DetachButton" Style="{StaticResource BtnGhost}" Content="Détacher" Click="Detach_Click" Margin="0,0,12,6"
                      VerticalAlignment="Center"
                      ToolTip="Ouvre le programme dans une fenêtre à part (idéal sur un deuxième écran) : l'aperçu prend toute la place ici" />
              <Button x:Name="ExpandButton" Style="{StaticResource BtnGhost}" Content="Agrandir" Click="Expand_Click" Margin="0,0,12,6"
                      VerticalAlignment="Center" ToolTip="Affiche le programme sur toute la page (Échap pour revenir)" />
              </WrapPanel>
            </StackPanel>
            <ItemsControl x:Name="WarningsList" Grid.Row="1" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource WarnBg}" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                    <TextBlock Text="{Binding}" Foreground="{DynamicResource WarnFg}" TextWrapping="Wrap" FontSize="12.5" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Éditeur : numéros de ligne + programme modifiable -->
            <Grid Grid.Row="2" Margin="0,4,0,0" MinHeight="170">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Background="{DynamicResource Surface2}" CornerRadius="8,0,0,8" BorderBrush="{DynamicResource Line}" BorderThickness="1,1,0,1" ClipToBounds="True">
                <Canvas Width="46" ClipToBounds="True">
                  <TextBlock x:Name="LineNumbers" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{DynamicResource Muted}" TextAlignment="Right"
                             Width="46" Padding="0,0,8,0" Text="1" />
                </Canvas>
              </Border>
              <!-- Coloration : le texte coloré est dessiné sous la zone de saisie, dont les caractères sont transparents. -->
              <Border Grid.Column="1" Background="{DynamicResource Surface2}" CornerRadius="0,8,8,0" />
              <Canvas x:Name="CodeOverlay" Grid.Column="1" IsHitTestVisible="False">
                <TextBlock x:Name="CodeColors" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{DynamicResource Ink}" />
              </Canvas>
              <TextBox x:Name="CodeBox" Grid.Column="1" Style="{StaticResource Input}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                       Background="Transparent" Foreground="Transparent" SelectionOpacity="0.35"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                       TextChanged="CodeBox_TextChanged" SelectionChanged="CodeBox_SelectionChanged"
                       ToolTip="Modifiable : chaque ligne peut être retouchée, l'envoi part tel quel" />
              <TextBlock x:Name="CodeHint" Grid.Column="1" Margin="14,10,14,0" IsHitTestVisible="False" TextWrapping="Wrap" Visibility="Collapsed"
                         FontSize="13" Foreground="{DynamicResource Muted}"
                         Text="Colle ici le programme ZPL du client (Ctrl + V), ouvre son fichier, ou glisse-le sur la page." />
            </Grid>
            <StackPanel Grid.Row="3">
            <WrapPanel x:Name="Legend" Margin="0,6,0,0" />
            <TextBlock x:Name="EditedNote" FontSize="12" Foreground="{DynamicResource BrandText}" Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap"
                       Text="Programme retouché à la main : il n'est plus régénéré tant que tu ne changes pas un réglage." />
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,12,0,0">
              <WrapPanel>
                <Button Style="{StaticResource BtnSecondary}" Content="Copier" Click="Copy_Click" Margin="0,0,8,0" />
                <Button Style="{StaticResource BtnSecondary}" Content="Enregistrer…" Click="Save_Click" Margin="0,0,8,0" />
                <Button x:Name="RegenerateButton" Style="{StaticResource BtnGhost}" Content="Régénérer" Click="Regenerate_Click"
                        ToolTip="Abandonne les retouches manuelles et repart des réglages" />
              </WrapPanel>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
  </ScrollViewer>
</UserControl>
