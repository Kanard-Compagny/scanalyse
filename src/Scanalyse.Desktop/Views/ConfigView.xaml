<UserControl x:Class="Scanalyse.Desktop.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
  <!-- Conf imprimante : fichier de configuration expliqué et contrôlé, comparé à l'imprimante (Zebra), puis envoyé. -->
  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="28,22,28,16">
  <Grid MinHeight="700" Height="{Binding ViewportHeight, ElementName=PageScroll}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,16">
      <TextBlock Style="{StaticResource PageTitle}" Text="Conf imprimante" />
      <TextBlock Style="{StaticResource PageSubtitle}"
                 Text="Colle ou ouvre le fichier de configuration d'une imprimante (Zebra ZPL et SGD « ! U1 setvar », TSC TSPL, Honeywell DPL et Fingerprint, SATO SBPL, EPL2) : chaque ligne est expliquée et contrôlée, comparée à l'imprimante, puis envoyée." />
    </StackPanel>

    <!-- Imprimante : la même que « Code imprimante », présentée de la même façon -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,14">
      <StackPanel>
      <DockPanel>
        <Button DockPanel.Dock="Right" x:Name="SendButton" Style="{StaticResource BtnAction}" Content="Envoyer à l'imprimante" Click="Send_Click" Margin="8,0,0,0" VerticalAlignment="Center" />
        <Button DockPanel.Dock="Right" x:Name="ReadButton" Style="{StaticResource BtnSecondary}" Content="Lire l'imprimante" Click="Read_Click" Margin="12,0,0,0" VerticalAlignment="Center"
                ToolTip="Lit tous les réglages de l'imprimante (Zebra, par le réseau) pour les comparer au fichier et vérifier les valeurs acceptées par ce modèle" />
        <TextBlock DockPanel.Dock="Left" Text="Imprimante" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <RadioButton x:Name="TargetTcp" Style="{StaticResource Chip}" GroupName="ConfTarget" Content="Réseau (IP, port 9100)" IsChecked="True" Checked="Target_Changed" Margin="0,0,6,0" />
          <RadioButton x:Name="TargetQueue" Style="{StaticResource Chip}" GroupName="ConfTarget" Content="Installée sur ce PC" Checked="Target_Changed" />
        </StackPanel>
        <Grid VerticalAlignment="Center">
          <Grid x:Name="AddressPanel">
            <TextBox x:Name="AddressBox" Style="{StaticResource FieldInput}" LostFocus="Address_LostFocus"
                     ToolTip="Adresse IP de l'imprimante (ex. 192.168.1.50 ou 192.168.1.50:9100)" />
            <TextBlock x:Name="AddressHint" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Muted}" FontSize="13"
                       Text="ex. 192.168.1.50 ou 192.168.1.50:6101" />
          </Grid>
          <StackPanel x:Name="QueuePanel" Visibility="Collapsed">
            <Button x:Name="QueueButton" Style="{StaticResource BtnSecondary}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="QueueButton_Click"
                    ToolTip="Choisir l'imprimante (les données partent en mode RAW : le pilote ne les modifie pas)">
              <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="▾" FontSize="14" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                <TextBlock x:Name="QueueCount" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock x:Name="QueueSelected" Text="Choisir une imprimante…" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </DockPanel>
            </Button>
            <Popup x:Name="QueuePopup" PlacementTarget="{Binding ElementName=QueueButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                   Width="{Binding ActualWidth, ElementName=QueueButton}" PopupAnimation="Fade">
              <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,6,0,0">
                <StackPanel>
                  <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="Actualiser" Click="RefreshQueues_Click" Padding="8,2" Margin="8,0,0,0" />
                    <Grid>
                      <TextBox x:Name="QueueSearch" Style="{StaticResource FieldInput}" TextChanged="QueueSearch_TextChanged" />
                      <TextBlock x:Name="QueueSearchHint" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Muted}" FontSize="13"
                                 Text="Rechercher (nom, serveur…)" />
                    </Grid>
                  </DockPanel>
                  <ScrollViewer x:Name="QueueScroll" MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="QueueChips" />
                  </ScrollViewer>
                  <TextBlock x:Name="QueueHint" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                             Text="Les données partent en mode RAW : le pilote ne les modifie pas (pilote Zebra, Honeywell, TSC… ou « Generic / Text Only »)." />
                </StackPanel>
              </Border>
            </Popup>
          </StackPanel>
        </Grid>
      </DockPanel>
      <!-- Imprimante reconnue : marque, modèle, langages, réglages lus ; sert de référence à l'analyse -->
      <DockPanel Margin="0,8,0,0">
        <Ellipse x:Name="ProfileDot" Width="8" Height="8" Margin="2,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource Muted}" />
        <TextBlock x:Name="ProfileText" FontSize="12.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"
                   Text="Choisis une imprimante : Scanalyse la reconnaît (toutes marques) et vérifie que le fichier lui convient." />
      </DockPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="6*" />
      </Grid.ColumnDefinitions>

      <!-- Fichier -->
      <Border Style="{StaticResource Card}">
        <DockPanel>
          <!-- Titre toujours sur une ligne ; les boutons passent à la ligne quand la fenêtre est étroite -->
          <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource CardTitle}" Text="Fichier de configuration" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="0,0,12,0" />
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Style="{StaticResource BtnGhost}" Content="Ouvrir un fichier…" Click="Open_Click" Margin="0,0,4,0" />
              <Button x:Name="ConvertButton" Style="{StaticResource BtnGhost}" Content="Convertir vers…" Click="ConvertButton_Click" Margin="0,0,4,0"
                      ToolTip="Réécrit le fichier dans le langage d'une autre marque (ZPL, SGD, TSPL, EPL2, DPL, Fingerprint, SBPL), avec le compte-rendu de ce qui a été repris" />
              <Popup x:Name="ConvertPopup" PlacementTarget="{Binding ElementName=ConvertButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,6,0,0" Width="420">
                  <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Convertir le fichier" />
                    <TextBlock FontSize="12.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10"
                               Text="Les réglages communs (noirceur, vitesse, support, méthode, sortie, taille, décalages, réseau) sont réécrits ; ce qui est propre à une marque est listé dans le compte-rendu." />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Langage d'arrivée" />
                    <WrapPanel x:Name="ConvertTargets" Margin="0,4,0,10" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Résolution de la tête (pour passer des points aux millimètres)" />
                    <WrapPanel x:Name="ConvertDpi" Margin="0,4,0,12" />
                    <Button Style="{StaticResource BtnAction}" Content="Convertir" Click="Convert_Click" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </Popup>
              <Button Style="{StaticResource BtnGhost}" Content="Enregistrer sous…" Click="SaveAs_Click" Margin="0,0,4,0"
                      ToolTip="Enregistre le fichier, avec tes modifications, sous le nom de ton choix (Ctrl + S)" />
              <Button Style="{StaticResource BtnGhost}" Content="Coller" Click="Paste_Click" Margin="0,0,4,0" />
              <Button Style="{StaticResource BtnGhost}" Content="Effacer" Click="Clear_Click" />
            </WrapPanel>
          </Grid>
          <TextBlock x:Name="FileInfo" DockPanel.Dock="Bottom" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" />
          <WrapPanel x:Name="Legend" DockPanel.Dock="Bottom" Margin="0,8,0,0" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Numéros de ligne : en rouge ou en jaune quand la ligne a une erreur ou un point à vérifier -->
            <Border Background="{DynamicResource Surface2}" CornerRadius="8,0,0,8" BorderBrush="{DynamicResource Line}" BorderThickness="1,1,0,1" ClipToBounds="True">
              <Canvas Width="44" ClipToBounds="True">
                <TextBlock x:Name="LineNumbers" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{DynamicResource Muted}" TextAlignment="Right"
                           Width="44" Padding="0,0,8,0" Text="1" />
              </Canvas>
            </Border>
            <!-- Coloration : texte coloré et bandeaux d'erreur dessinés sous la zone de saisie, dont les caractères sont transparents. -->
            <Border Grid.Column="1" Background="{DynamicResource Surface2}" CornerRadius="0,8,8,0" />
            <Canvas x:Name="CodeOverlay" Grid.Column="1" IsHitTestVisible="False">
              <Canvas x:Name="MarkLayer" />
              <TextBlock x:Name="CodeColors" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{DynamicResource Ink}" />
            </Canvas>
            <TextBox x:Name="CodeBox" Grid.Column="1" Style="{StaticResource Input}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                     FontFamily="{StaticResource MonoFont}" FontSize="13" VerticalContentAlignment="Top"
                     Background="Transparent" Foreground="Transparent" SelectionOpacity="0.35"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="CodeBox_TextChanged"
                     PreviewKeyDown="CodeBox_PreviewKeyDown" PreviewTextInput="CodeBox_PreviewTextInput" LostKeyboardFocus="CodeBox_LostKeyboardFocus"
                     MouseMove="CodeBox_MouseMove" ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="30000" />
            <TextBlock x:Name="CodeHint" Grid.Column="1" Margin="14,10,14,0" IsHitTestVisible="False" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Muted}"
                       Text="Colle ici le fichier de configuration (Ctrl + V), ouvre-le, ou glisse-le sur la page. Tape une commande pour voir les propositions (Ctrl + Espace : toute la bibliothèque). Exemple : ! U1 setvar &quot;print.tone&quot; &quot;20&quot;" />
            <!-- Propositions à la saisie (bibliothèque intégrée) -->
            <Popup x:Name="SuggestPopup" Grid.Column="1" PlacementTarget="{Binding ElementName=CodeBox}" Placement="RelativePoint" StaysOpen="True" AllowsTransparency="True" Focusable="False">
              <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="4" Width="520">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35" />
                </Border.Effect>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Bottom" x:Name="SuggestFooter" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="8,4,8,2" TextTrimming="CharacterEllipsis"
                             Text="↑ ↓ choisir · Entrée ou Tab insérer · Échap fermer" />
                  <ScrollViewer x:Name="SuggestScroll" MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel x:Name="SuggestList" />
                  </ScrollViewer>
                </DockPanel>
              </Border>
            </Popup>
          </Grid>
        </DockPanel>
      </Border>

      <!-- Analyse -->
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="ResultTitle" Style="{StaticResource CardTitle}" FontSize="18" Text="Analyse" />
            <TextBlock x:Name="ResultSummary" Style="{StaticResource PageSubtitle}" Margin="0,4,0,10" Text="Le fichier est analysé dès qu'il est collé ou ouvert." />
            <Border x:Name="RiskBanner" Background="{DynamicResource WarnBg}" CornerRadius="8" Padding="12,9" Margin="0,0,0,10" Visibility="Collapsed">
              <TextBlock x:Name="RiskText" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource WarnFg}" />
            </Border>
            <Border x:Name="PrinterBanner" Background="{DynamicResource InfoBg}" CornerRadius="8" Padding="12,9" Margin="0,0,0,10" Visibility="Collapsed">
              <TextBlock x:Name="PrinterText" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource InfoFg}" />
            </Border>
            <WrapPanel x:Name="ViewChips" Margin="0,0,0,8">
              <RadioButton x:Name="ViewProblems" Style="{StaticResource Chip}" GroupName="ConfView" Content="Points à vérifier" IsChecked="True" Checked="View_Changed" />
              <RadioButton x:Name="ViewLines" Style="{StaticResource Chip}" GroupName="ConfView" Content="Ligne par ligne" Checked="View_Changed" />
              <RadioButton x:Name="ViewSettings" Style="{StaticResource Chip}" GroupName="ConfView" Content="Réglages appliqués" Checked="View_Changed" />
              <RadioButton x:Name="ViewAssistant" Style="{StaticResource Chip}" GroupName="ConfView" Content="Configurer" Checked="View_Changed"
                           ToolTip="Assistant : règle noirceur, vitesse, support, sortie, taille, réseau… et Scanalyse écrit le fichier dans le langage de ton choix" />
              <RadioButton x:Name="ViewConversion" Style="{StaticResource Chip}" GroupName="ConfView" Content="Conversion" Checked="View_Changed" Visibility="Collapsed"
                           ToolTip="Compte-rendu de la dernière conversion : repris, approché, non converti" />
            </WrapPanel>
          </StackPanel>
          <Grid>
            <ScrollViewer x:Name="ResultScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="ResultPanel" Margin="0,0,6,0" />
            </ScrollViewer>
            <!-- Assistant « Configurer » : formulaire construit une fois, conservé entre deux analyses -->
            <ScrollViewer x:Name="AssistantScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
              <StackPanel x:Name="AssistantPanel" Margin="0,0,6,0" />
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
  </ScrollViewer>
</UserControl>
