<UserControl x:Class="Scanalyse.Desktop.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Page de connexion : chaque type de liaison a sa carte. L'analyse des lectures se fait au banc d'essai. -->
  <Grid Margin="28,22,28,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,18">
      <TextBlock Style="{StaticResource PageTitle}" Text="Appareils de lecture" />
      <TextBlock Style="{StaticResource PageSubtitle}"
                 Text="Connexion des appareils de lecture : douchettes USB, série et HID POS, terminaux Android, caméras. Les lectures reçues partent au banc d'essai." />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- Périphériques -->
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Click="Refresh_Click" ToolTip="Rechercher à nouveau les douchettes branchées">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="14" Height="14"><Path Data="{StaticResource IconRefresh}" Width="24" Height="24" Stroke="{DynamicResource BrandText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                    <TextBlock Text="Actualiser" Margin="6,0,0,0" />
                  </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource CardTitle}" Text="Douchettes USB, série et HID POS" VerticalAlignment="Center" />
              </DockPanel>
              <StackPanel x:Name="DeviceList" />
              <TextBlock x:Name="DeviceHint" Style="{StaticResource FieldLabel}" Margin="0,4,0,0" Visibility="Collapsed"
                         Text="Aucun port COM, scanner HID POS ni caméra trouvé. La douchette est sans doute en mode clavier : voir « Passer en liaison directe » plus bas." />

              <Border Height="1" Background="{DynamicResource Line}" Margin="0,14" />
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button x:Name="DisconnectButton" Style="{StaticResource BtnSecondary}" Content="Déconnecter" Click="Disconnect_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                  <Button x:Name="ConnectButton" Style="{StaticResource BtnAction}" Content="Connecter" Click="Connect_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource Muted}" VerticalAlignment="Center" />
                  <TextBlock x:Name="StatusText" Text="Mode clavier" Margin="9,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Ink}" />
                </StackPanel>
              </DockPanel>
            </StackPanel>
          </Border>

          <!-- Réglages du port série -->
          <Border x:Name="SerialCard" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="Réglages du port série" />
              <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,12"
                         Text="Indispensables en RS-232 : ils doivent être identiques à ceux de la douchette. En port COM virtuel USB, vitesse et parité sont le plus souvent ignorées." />

              <TextBlock Style="{StaticResource FieldLabel}" Text="Vitesse (bauds)" />
              <WrapPanel x:Name="BaudChips" Margin="0,0,0,8">
                <RadioButton Style="{StaticResource Chip}" GroupName="Baud" Tag="1200" Content="1200" />
                <RadioButton Style="{StaticResource Chip}" GroupName="Baud" Tag="2400" Content="2400" />
                <RadioButton Style="{StaticResource Chip}" GroupName="Baud" Tag="4800" Content="4800" />
                <RadioButton Style="{StaticResource Chip}" GroupName="Baud" Tag="9600" Content="9600" IsChecked="True" />
                <RadioButton Style="{StaticResource Chip}" GroupName="Baud" Tag="19200" Content="19200" />
                <RadioButton Style="{StaticResource Chip}" GroupName="Baud" Tag="38400" Content="38400" />
                <RadioButton Style="{StaticResource Chip}" GroupName="Baud" Tag="57600" Content="57600" />
                <RadioButton Style="{StaticResource Chip}" GroupName="Baud" Tag="115200" Content="115200" />
              </WrapPanel>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Bits de données" />
                  <WrapPanel x:Name="DataBitsChips" Margin="0,0,0,8">
                    <RadioButton Style="{StaticResource Chip}" GroupName="DataBits" Tag="7" Content="7" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="DataBits" Tag="8" Content="8" IsChecked="True" />
                  </WrapPanel>
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Bits d'arrêt" />
                  <WrapPanel x:Name="StopBitsChips" Margin="0,0,0,8">
                    <RadioButton Style="{StaticResource Chip}" GroupName="StopBits" Tag="One" Content="1" IsChecked="True" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="StopBits" Tag="Two" Content="2" />
                  </WrapPanel>
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Signal DTR (PC prêt)" />
                  <WrapPanel x:Name="DtrChips" Margin="0,0,0,8">
                    <RadioButton Style="{StaticResource Chip}" GroupName="Dtr" Tag="True" Content="Activé" IsChecked="True" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Dtr" Tag="False" Content="Désactivé" />
                  </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Parité" />
                  <WrapPanel x:Name="ParityChips" Margin="0,0,0,8">
                    <RadioButton Style="{StaticResource Chip}" GroupName="Parity" Tag="None" Content="Aucune" IsChecked="True" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Parity" Tag="Even" Content="Paire" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Parity" Tag="Odd" Content="Impaire" />
                  </WrapPanel>
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Contrôle de flux" />
                  <WrapPanel x:Name="FlowChips" Margin="0,0,0,8">
                    <RadioButton Style="{StaticResource Chip}" GroupName="Flow" Tag="None" Content="Aucun" IsChecked="True" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Flow" Tag="RequestToSend" Content="RTS/CTS" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Flow" Tag="XOnXOff" Content="XON/XOFF" />
                  </WrapPanel>
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Encodage du texte" />
                  <WrapPanel x:Name="EncodingChips" Margin="0,0,0,8">
                    <RadioButton Style="{StaticResource Chip}" GroupName="Encoding" Tag="Auto" Content="Auto" IsChecked="True" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Encoding" Tag="Utf8" Content="UTF-8" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Encoding" Tag="Latin1" Content="Latin-1" />
                  </WrapPanel>
                </StackPanel>
              </Grid>

              <TextBlock Style="{StaticResource FieldLabel}" Text="Fin de lecture : silence de (ms)" />
              <TextBox x:Name="IdleBox" Style="{StaticResource Input}" Width="120" HorizontalAlignment="Left" Text="80"
                       ToolTip="Une lecture est terminée quand la ligne reste silencieuse ce temps-là. Augmente-le si une lecture arrive coupée en deux." />
            </StackPanel>
          </Border>

          <!-- Aide -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="Passer en liaison directe" />
              <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Ink}"
                         Text="Une douchette USB sort d'usine en mode clavier. Pour une liaison directe, scanne dans le guide de programmation du fabricant le code qui change l'interface USB :" />
              <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Ink}">
                <Run FontWeight="SemiBold" Text="Port COM virtuel : " /><Run Text="« USB CDC » chez Zebra, « USB Serial » chez Honeywell, « USB-COM » chez Datalogic. Windows crée un port COM, puis clique sur Actualiser." />
              </TextBlock>
              <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Ink}">
                <Run FontWeight="SemiBold" Text="HID POS : " /><Run Text="« USB HID POS », si le modèle le propose. Windows le reconnaît sans pilote et indique en plus la symbologie lue." />
              </TextBlock>
              <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0"
                         Text="Pense à remettre la douchette dans son mode d'origine avant de la rendre au client." />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- Terminaux Android : relais -->
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Click="RefreshTerminals_Click" ToolTip="Rechercher les terminaux branchés en USB">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="14" Height="14"><Path Data="{StaticResource IconRefresh}" Width="24" Height="24" Stroke="{DynamicResource BrandText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                    <TextBlock Text="Actualiser" Margin="6,0,0,0" />
                  </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource CardTitle}" Text="Terminaux Android (relais)" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,0,0,12"
                         Text="Rien à installer sur le terminal : Scanalyse ouvre une page de relais dans son navigateur, la douchette intégrée y tape la lecture, et elle arrive ici avec le détail des touches. Zebra, Honeywell, Datalogic… toutes marques." />

              <DockPanel Margin="0,0,0,10">
                <Button x:Name="AdbPickButton" DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Choisir adb.exe…" Click="PickAdb_Click" Margin="8,0,0,0" />
                <TextBlock x:Name="AdbStatus" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
              </DockPanel>
              <StackPanel x:Name="TerminalList" />
              <StackPanel x:Name="SessionPanel" Visibility="Collapsed" Margin="0,4,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Terminaux reliés en ce moment" />
                <StackPanel x:Name="SessionList" />
              </StackPanel>

              <Border Height="1" Background="{DynamicResource Line}" Margin="0,12" />
              <CheckBox x:Name="WifiCheck" Style="{StaticResource CheckLine}" Content="Accepter aussi les terminaux en Wi-Fi (même réseau que le PC)" Click="Wifi_Click" />
              <StackPanel x:Name="WifiNetworks" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Réseau du PC à utiliser (celui du terminal) :" />
                <WrapPanel x:Name="AddressChips" />
              </StackPanel>
              <Grid x:Name="WifiPanel" Margin="0,10,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="14" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border CornerRadius="8" Background="White" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10" VerticalAlignment="Top">
                  <Image x:Name="WifiQr" Width="176" Height="176" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Adresse du relais :" />
                  <TextBox x:Name="WifiUrl" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" FontFamily="{StaticResource MonoFont}" FontSize="14"
                           FontWeight="SemiBold" Foreground="{DynamicResource BrandText}" TextWrapping="Wrap" />
                  <TextBlock TextWrapping="Wrap" FontSize="12.5" Margin="0,8,0,0" Foreground="{DynamicResource Ink}"
                             Text="Sur le terminal : ouvre le navigateur, touche la barre d'adresse, puis scanne ce QR avec le lecteur du terminal. L'adresse s'écrit, la douchette envoie Entrée, et la page s'ouvre." />
                  <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,0"
                             Text="Le lecteur ne fait que taper le contenu du QR : scanné hors de la barre d'adresse, il ne se passe rien." />
                </StackPanel>
              </Grid>
              <Border x:Name="WifiHelp" Background="{DynamicResource WarnBg}" CornerRadius="8" Padding="12,10" Margin="0,10,0,0" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource WarnFg}" Text="La page ne s'ouvre pas sur le terminal ?" />
                  <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource WarnFg}" Margin="0,4,0,8">
                    <Run Text="1. Pare-feu : Windows bloque souvent les connexions entrantes, surtout sur un réseau classé « public ». Autorise Scanalyse avec le bouton ci-dessous (droits administrateur, réseau local seulement)." /><LineBreak />
                    <Run Text="2. Adresse : choisis la carte du réseau sur lequel est le terminal (pas un VPN ni une carte virtuelle)." /><LineBreak />
                    <Run Text="3. Wi-Fi d'entreprise ou invité : l'« isolation des clients » empêche les appareils de se joindre entre eux. Dans ce cas, passe par le câble USB." />
                  </TextBlock>
                  <Button Style="{StaticResource BtnSecondary}" Content="Autoriser Scanalyse dans le pare-feu" Click="Firewall_Click" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="12,9" Margin="0,12,0,0">
                <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Ink}">
                  <Run FontWeight="SemiBold" Text="Données brutes (Zebra DataWedge, sortie IP) : " /><Run x:Name="RawHint" />
                </TextBlock>
              </Border>
            </StackPanel>
          </Border>

          <!-- Caméras -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="Caméras" />
              <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,12"
                         Text="Webcams et caméras document : lecture des codes en direct dans « Analyser une image »." />
              <StackPanel x:Name="CameraList" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
