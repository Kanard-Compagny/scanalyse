<UserControl x:Class="Scanalyse.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Scanalyse.Desktop.Views">
  <UserControl.Resources>
    <!-- Pastille de résultat : couleur selon la gravité (suit le thème) -->
    <Style x:Key="VerdictPill" TargetType="Border" BasedOn="{StaticResource Pill}">
      <Setter Property="Background" Value="{DynamicResource OkBg}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Worst}" Value="Info">
          <Setter Property="Background" Value="{DynamicResource InfoBg}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Worst}" Value="Warning">
          <Setter Property="Background" Value="{DynamicResource WarnBg}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Worst}" Value="Error">
          <Setter Property="Background" Value="{DynamicResource BadBg}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="VerdictText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource OkFg}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Worst}" Value="Info">
          <Setter Property="Foreground" Value="{DynamicResource InfoFg}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Worst}" Value="Warning">
          <Setter Property="Foreground" Value="{DynamicResource WarnFg}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Worst}" Value="Error">
          <Setter Property="Foreground" Value="{DynamicResource BadFg}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <!-- Hauteur de la fenêtre si elle suffit, sinon hauteur minimale et défilement : la liste des analyses n'est jamais écrasée par la fiche du dossier. -->
  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="28,22,28,16">
  <Grid MinHeight="760" Height="{Binding ViewportHeight, ElementName=PageScroll}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,18">
      <TextBlock Style="{StaticResource PageTitle}" Text="Historique" />
      <TextBlock Style="{StaticResource PageSubtitle}"
                 Text="Chaque analyse d'image et chaque comparaison douchette est enregistrée dans le dossier en cours. Un dossier par intervention, et un rapport PDF à remettre au client." />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="220" MaxWidth="300" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="3*" />
      </Grid.ColumnDefinitions>

      <!-- Dossiers -->
      <Border Style="{StaticResource Card}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Nouveau dossier" Click="NewCase_Click" />
            <TextBlock Style="{StaticResource CardTitle}" Text="Dossiers" VerticalAlignment="Center" />
          </DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="CaseList" />
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="220" />
        </Grid.RowDefinitions>

        <!-- Dossier sélectionné -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
          <StackPanel>
            <DockPanel>
              <Border x:Name="ActiveBadge" DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{DynamicResource BrandSoft}" VerticalAlignment="Top">
                <TextBlock Text="Dossier en cours" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrandText}" />
              </Border>
              <TextBlock x:Name="CaseTitle" Style="{StaticResource CardTitle}" FontSize="18" />
            </DockPanel>
            <TextBlock x:Name="InboxHint" Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" Visibility="Collapsed"
                       Text="Les analyses faites sans dossier arrivent ici. Crée un dossier pour une intervention, puis range-y les analyses utiles." />

            <Grid x:Name="CaseFields" Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Client / site" />
                <TextBox x:Name="ClientBox" Style="{StaticResource FieldInput}" LostFocus="CaseField_LostFocus" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Référence (ticket, intervention)" />
                <TextBox x:Name="ReferenceBox" Style="{StaticResource FieldInput}" LostFocus="CaseField_LostFocus" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Intervenant" />
                <TextBox x:Name="TechnicianBox" Style="{StaticResource FieldInput}" LostFocus="CaseField_LostFocus" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="0,10,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Notes : matériel, contexte, conclusion (reprises dans le rapport)" />
                <TextBox x:Name="NotesBox" Style="{StaticResource FieldInput}" AcceptsReturn="True" MinHeight="64" MaxHeight="140" LostFocus="CaseField_LostFocus" />
              </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <TextBlock Style="{StaticResource FieldLabel}" Text="Contenu des codes dans le rapport :" VerticalAlignment="Center" Margin="0,0,10,6" />
              <WrapPanel x:Name="ReportContentChips">
                <RadioButton Style="{StaticResource Chip}" GroupName="ReportContent" Tag="Detailed" Content="Détaillé" Checked="ReportContent_Checked"
                             ToolTip="Vue structurée (sections, champs), interprétation et caractéristiques : lisible par le client" />
                <RadioButton Style="{StaticResource Chip}" GroupName="ReportContent" Tag="Raw" Content="Brut" Checked="ReportContent_Checked"
                             ToolTip="Contenu tel que lu et octets en hexadécimal : pour un intégrateur ou un éditeur de logiciel" />
                <RadioButton Style="{StaticResource Chip}" GroupName="ReportContent" Tag="Both" Content="Les deux" Checked="ReportContent_Checked" />
              </WrapPanel>
            </StackPanel>
            <WrapPanel Margin="0,8,0,0">
              <Button Margin="0,0,8,8" x:Name="UseCaseButton" Style="{StaticResource BtnSecondary}" Content="Travailler sur ce dossier" Click="UseCase_Click" />
              <Button Margin="0,0,8,8" Style="{StaticResource BtnAction}" Content="Rapport du dossier (PDF)" Click="Report_Click" />
              <Button Margin="0,0,8,8" x:Name="ClientReportButton" Style="{StaticResource BtnSecondary}" Click="ClientReport_Click"  Visibility="Collapsed" />
              <Button Margin="0,0,8,8" x:Name="EmptyCaseButton" Style="{StaticResource BtnGhost}" Content="Vider le dossier" Click="EmptyCase_Click" 
                      ToolTip="Supprime toutes les analyses de ce dossier ; le dossier et sa fiche sont conservés" />
              <Button Margin="0,0,8,8" x:Name="DeleteCaseButton" Style="{StaticResource BtnGhost}" Content="Supprimer le dossier" Click="DeleteCase_Click"  />
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- Recherche et filtres -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="220" MaxWidth="300" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>
          <Grid VerticalAlignment="Center">
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchInput}" TextChanged="Filter_Changed" AutomationProperties.Name="Rechercher dans le dossier" />
            <Viewbox Width="16" Height="16" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False">
              <Path Data="{StaticResource IconSearch}" Width="24" Height="24" Stroke="{DynamicResource Muted}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Viewbox>
            <TextBlock x:Name="SearchPlaceholder" Text="Rechercher : contenu, GTIN, lot, source…" Margin="37,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Muted}" IsHitTestVisible="False" />
          </Grid>
          <WrapPanel x:Name="KindChips" Grid.Column="2" VerticalAlignment="Center">
            <RadioButton Style="{StaticResource Chip}" GroupName="HistKind" Tag="all" Content="Tout" IsChecked="True" Checked="Filter_Changed" />
            <RadioButton Style="{StaticResource Chip}" GroupName="HistKind" Tag="image" Content="Images" Checked="Filter_Changed" />
            <RadioButton Style="{StaticResource Chip}" GroupName="HistKind" Tag="compare" Content="Comparaisons" Checked="Filter_Changed" />
            <RadioButton Style="{StaticResource Chip}" GroupName="HistKind" Tag="issues" Content="Problèmes" Checked="Filter_Changed" />
            <TextBlock x:Name="CountText" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,6" />
          </WrapPanel>
        </Grid>

        <!-- Entrées -->
        <Grid Grid.Row="2">
          <TextBlock x:Name="EmptyText" Text="Aucune analyse dans ce dossier pour l'instant."
                     Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="EntryList">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type views:EntryView}">
                  <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Width="128" Height="84" CornerRadius="6" Background="White" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <Grid>
                          <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="4" />
                          <TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="#5D656C" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Visibility="{Binding NoThumbVisibility}" />
                        </Grid>
                      </Border>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBox Style="{StaticResource InlineInput}" Text="{Binding Entry.Title, Mode=OneTime}" FontWeight="SemiBold" FontSize="14" Margin="-6,-3,0,0"
                                 Tag="Nom de l'analyse" ToolTip="Clique pour renommer l'analyse (problème rencontré, repère…). Vide : nom automatique."
                                 LostFocus="Title_LostFocus" KeyDown="Inline_KeyDown" MaxLength="120" />
                        <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBox Style="{StaticResource InlineInput}" Text="{Binding Entry.Comment, Mode=OneTime}" FontSize="12.5" Margin="-6,4,0,0"
                                 Tag="Ajouter un commentaire : problème rencontré, action menée…" AcceptsReturn="True" MaxHeight="90"
                                 LostFocus="Comment_LostFocus" />
                        <TextBlock Text="{Binding Detail}" FontSize="12.5" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   FontFamily="{StaticResource MonoFont}" MaxHeight="54" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="3" Margin="12,0,0,0" HorizontalAlignment="Right">
                        <Border Style="{StaticResource VerdictPill}" HorizontalAlignment="Right">
                          <TextBlock Style="{StaticResource VerdictText}" Text="{Binding Verdict}" />
                        </Border>
                        <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
                          <Button Style="{StaticResource BtnSmall}" Content="Rouvrir" Click="Reopen_Click" Margin="0,0,6,0" />
                          <Button Style="{StaticResource BtnSmall}" Content="Déplacer vers…" Click="Move_Click" Margin="0,0,6,0" />
                          <Button Style="{StaticResource BtnSmall}" Content="Supprimer" Click="DeleteEntry_Click" />
                        </WrapPanel>
                        <CheckBox Style="{StaticResource CheckLine}" Content="Dans le rapport" IsChecked="{Binding InReport, Mode=OneWay}"
                                  Click="InReport_Click" HorizontalAlignment="Right" Margin="0,10,0,0" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
  </ScrollViewer>
</UserControl>
