<UserControl x:Class="Scanalyse.Desktop.Views.BenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Scanalyse.Desktop.Views">
  <UserControl.Resources>
    <!-- Couleurs d'un constat selon sa gravité (suivent le thème) -->
    <Style x:Key="FindingBox" TargetType="Border">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Background" Value="{DynamicResource InfoBg}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Severity}" Value="Ok">
          <Setter Property="Background" Value="{DynamicResource OkBg}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="Warning">
          <Setter Property="Background" Value="{DynamicResource WarnBg}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="Error">
          <Setter Property="Background" Value="{DynamicResource BadBg}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="FindingTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource InfoFg}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Severity}" Value="Ok">
          <Setter Property="Foreground" Value="{DynamicResource OkFg}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="Warning">
          <Setter Property="Foreground" Value="{DynamicResource WarnFg}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="Error">
          <Setter Property="Foreground" Value="{DynamicResource BadFg}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="28,22,28,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,18">
      <TextBlock Style="{StaticResource PageTitle}" Text="Banc d'essai douchette" />
      <TextBlock Style="{StaticResource PageSubtitle}"
                 Text="Compare le contenu réel d'un code avec ce que la douchette transmet, et explique chaque écart." />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="6*" />
      </Grid.ColumnDefinitions>

      <!-- Saisie -->
      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Contenu réel du code (accepte &lt;GS&gt;, &lt;CR&gt;… pour les caractères invisibles)" />
            <TextBlock x:Name="ExpectedSource" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource BrandText}" FontWeight="SemiBold" Visibility="Collapsed" />
          </StackPanel>
          <TextBox x:Name="ExpectedBox" Grid.Row="1" Style="{StaticResource Input}" AcceptsReturn="True" MinHeight="90"
                   TextChanged="ExpectedBox_TextChanged" Text="0103453120000011172712311010ABC123&lt;GS&gt;21SN7788" />

          <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Margin="0,16,0,5"
                     Text="Données reçues : clique dans le champ puis scanne avec la douchette (Entrée et Tab sont capturés)" />
          <TextBox x:Name="ReceivedBox" Grid.Row="3" Style="{StaticResource Input}" MinHeight="90"
                   PreviewKeyDown="ReceivedBox_PreviewKeyDown" TextChanged="ReceivedBox_TextChanged" />

          <TextBlock x:Name="ReceivedVisual" Grid.Row="4" Margin="0,8,0,0" FontFamily="{StaticResource MonoFont}" FontSize="12"
                     Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />

          <WrapPanel Grid.Row="5" Margin="0,16,0,0">
            <Button Style="{StaticResource BtnAction}" Content="Comparer" Click="Compare_Click" Margin="0,0,8,8" />
            <Button Style="{StaticResource BtnSecondary}" Content="Analyser le contenu" Click="Analyze_Click" Margin="0,0,8,8" />
            <Button Style="{StaticResource BtnGhost}" Content="Effacer la lecture" Click="Clear_Click" Margin="0,0,0,8" />
          </WrapPanel>
        </Grid>
      </Border>

      <!-- Résultat -->
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock x:Name="ResultTitle" Style="{StaticResource CardTitle}" FontSize="18" Text="Résultat" />
            <TextBlock x:Name="ResultSubtitle" Style="{StaticResource PageSubtitle}" Margin="0,4,0,14"
                       Text="Saisis le contenu du code, scanne-le dans le second champ, puis clique sur Comparer." />

            <ItemsControl x:Name="FindingsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type views:FindingView}">
                  <Border Style="{StaticResource FindingBox}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource FindingTitle}" Text="{Binding Title}" />
                      <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource Ink}" Visibility="{Binding ExplanationVisibility}" />
                      <TextBlock Text="{Binding Fix}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Muted}" Visibility="{Binding FixVisibility}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl x:Name="FieldsList" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type views:FieldView}">
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="210" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{DynamicResource Muted}" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
