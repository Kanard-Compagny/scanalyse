<UserControl x:Class="Scanalyse.Desktop.Views.BenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Scanalyse.Desktop.Views"
             PreviewKeyDown="Root_PreviewKeyDown">
  <UserControl.Resources>
    <!-- Couleurs d'un constat selon sa gravité (suivent le thème) -->
    <Style x:Key="FindingBox" TargetType="Border">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Background" Value="{DynamicResource InfoBg}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Severity}" Value="Ok">
          <Setter Property="Background" Value="{DynamicResource OkBg}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="Warning">
          <Setter Property="Background" Value="{DynamicResource WarnBg}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="Error">
          <Setter Property="Background" Value="{DynamicResource BadBg}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="FindingTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource InfoFg}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Severity}" Value="Ok">
          <Setter Property="Foreground" Value="{DynamicResource OkFg}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="Warning">
          <Setter Property="Foreground" Value="{DynamicResource WarnFg}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="Error">
          <Setter Property="Foreground" Value="{DynamicResource BadFg}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
  <Grid Margin="28,22,28,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,18">
      <TextBlock Style="{StaticResource PageTitle}" Text="Banc d'essai douchette" />
      <TextBlock Style="{StaticResource PageSubtitle}"
                 Text="Compare le contenu réel d'un code avec ce que la douchette transmet, et explique chaque écart." />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="6*" />
      </Grid.ColumnDefinitions>

      <!-- Saisie -->
      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Contenu réel du code (accepte &lt;GS&gt;, &lt;CR&gt;… pour les caractères invisibles)" />
            <TextBlock x:Name="ExpectedSource" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource BrandText}" FontWeight="SemiBold" Visibility="Collapsed" />
          </StackPanel>
          <TextBox x:Name="ExpectedBox" Grid.Row="1" Style="{StaticResource Input}" AcceptsReturn="True" MinHeight="90"
                   TextChanged="ExpectedBox_TextChanged" Text="0103453120000011172712311010ABC123&lt;GS&gt;21SN7788" />

          <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Margin="0,16,0,5"
                     Text="Données reçues : clique dans le champ puis scanne avec la douchette (Entrée et Tab sont capturés)" />
          <TextBox x:Name="ReceivedBox" Grid.Row="3" Style="{StaticResource Input}" MinHeight="90"
                   PreviewKeyDown="ReceivedBox_PreviewKeyDown" TextChanged="ReceivedBox_TextChanged" />

          <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock x:Name="ReceivedOrigin" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrandText}" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="ReceivedVisual" FontFamily="{StaticResource MonoFont}" FontSize="12"
                       Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
          </StackPanel>

          <WrapPanel Grid.Row="5" Margin="0,16,0,0">
            <Button Style="{StaticResource BtnAction}" Content="Comparer" Click="Compare_Click" Margin="0,0,8,8" />
            <Button Style="{StaticResource BtnSecondary}" Content="Analyser le contenu" Click="Analyze_Click" Margin="0,0,8,8" />
            <Button Style="{StaticResource BtnGhost}" Content="Effacer la lecture" Click="Clear_Click" Margin="0,0,0,8" />
          </WrapPanel>
        </Grid>
      </Border>

      <!-- Code testé + résultat -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Le code est toujours montré sur fond blanc, comme imprimé -->
            <Border x:Name="PreviewBox" Width="250" Height="170" CornerRadius="8" Background="White" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    MouseLeftButtonUp="PreviewBox_Click" ToolTip="Agrandir pour scanner à l'écran">
              <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="10" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <TextBlock x:Name="PreviewEmpty" Text="Aucun aperçu" Foreground="#5D656C" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border x:Name="ZoomHint" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" CornerRadius="6" Padding="6,3"
                        Background="#CC15191C" Visibility="Collapsed" IsHitTestVisible="False">
                  <TextBlock Text="Agrandir" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                </Border>
              </Grid>
            </Border>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource CardTitle}" Text="Code testé" />
              <TextBlock x:Name="PreviewSource" Style="{StaticResource PageSubtitle}"
                         Text="La vignette s'affiche quand la référence vient d'une image analysée. Sinon, choisis le type et génère l'aperçu." />
              <WrapPanel x:Name="PreviewTypes" Margin="0,10,0,0">
                <RadioButton Style="{StaticResource Chip}" GroupName="PreviewType" Tag="auto" Content="Auto" IsChecked="True" />
                <RadioButton Style="{StaticResource Chip}" GroupName="PreviewType" Tag="gs1datamatrix" Content="GS1 DataMatrix" />
                <RadioButton Style="{StaticResource Chip}" GroupName="PreviewType" Tag="datamatrix" Content="Data Matrix" />
                <RadioButton Style="{StaticResource Chip}" GroupName="PreviewType" Tag="gs1qr" Content="GS1 QR" />
                <RadioButton Style="{StaticResource Chip}" GroupName="PreviewType" Tag="gs1128" Content="GS1-128" />
                <RadioButton Style="{StaticResource Chip}" GroupName="PreviewType" Tag="code128" Content="Code 128" />
                <RadioButton Style="{StaticResource Chip}" GroupName="PreviewType" Tag="ean13" Content="EAN-13" />
                <RadioButton Style="{StaticResource Chip}" GroupName="PreviewType" Tag="pdf417" Content="PDF417" />
              </WrapPanel>
              <WrapPanel Margin="0,4,0,0">
                <Button Style="{StaticResource BtnSecondary}" Content="Générer l'aperçu" Click="Preview_Click" Margin="0,0,8,0" />
                <Button x:Name="ZoomButton" Style="{StaticResource BtnSecondary}" Content="Agrandir pour scanner" Click="Zoom_Click" IsEnabled="False" />
              </WrapPanel>
            </StackPanel>
          </Grid>
        </Border>

      <Border Grid.Row="1" Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock x:Name="ResultTitle" Style="{StaticResource CardTitle}" FontSize="18" Text="Résultat" />
            <TextBlock x:Name="ResultSubtitle" Style="{StaticResource PageSubtitle}" Margin="0,4,0,14"
                       Text="Saisis le contenu du code, scanne-le dans le second champ, puis clique sur Comparer." />

            <ItemsControl x:Name="FindingsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type views:FindingView}">
                  <Border Style="{StaticResource FindingBox}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource FindingTitle}" Text="{Binding Title}" />
                      <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource Ink}" Visibility="{Binding ExplanationVisibility}" />
                      <TextBlock Text="{Binding Fix}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Muted}" Visibility="{Binding FixVisibility}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl x:Name="FieldsList" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type views:FieldView}">
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="210" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{DynamicResource Muted}" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>
      </Grid>
    </Grid>
  </Grid>

  <!-- Agrandissement : le code en grand, sur fond blanc, pour le scanner directement à l'écran -->
  <Grid x:Name="ZoomOverlay" Visibility="Collapsed" Background="#B3000000" MouseLeftButtonUp="ZoomOverlay_Click">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border x:Name="ZoomSheet" Background="White" CornerRadius="12" Margin="32,32,32,12" Padding="32">
      <Grid x:Name="ZoomArea" SizeChanged="ZoomArea_SizeChanged">
        <Image x:Name="ZoomImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" />
      </Grid>
    </Border>
    <DockPanel Grid.Row="1" Margin="32,0,32,24" LastChildFill="False">
      <TextBlock x:Name="ZoomCaption" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="White" FontSize="13" TextWrapping="Wrap" />
      <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Content="Fermer (Échap)" Click="ZoomClose_Click" />
    </DockPanel>
  </Grid>
  </Grid>
</UserControl>
