<Window x:Class="Scanalyse.Desktop.ProgramWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Programme — Scanalyse"
        Icon="/Assets/Scanalyse.ico"
        Width="900" Height="760" MinWidth="560" MinHeight="420"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        ShowInTaskbar="False" StateChanged="Window_StateChanged">

  <!-- Même habillage que la fenêtre principale : barre de titre aux couleurs de Scanalyse -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Border x:Name="RootBorder" BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Background="{DynamicResource TitleBg}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Image Source="/Assets/logo-64.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock x:Name="TitleText" Text="Programme" Margin="10,0,0,0" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TitleInk}" VerticalAlignment="Center" />
          <TextBlock Text="Scanalyse" Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource TitleMuted}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource BtnCaption}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" ToolTip="Réduire">
            <Path Data="M0 5h10" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
          </Button>
          <Button Style="{StaticResource BtnCaption}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click" ToolTip="Agrandir / restaurer">
            <Path x:Name="MaxIcon" Data="M0.5 0.5h9v9h-9z" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
          </Button>
          <Button Style="{StaticResource BtnCaptionClose}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="Rattacher le programme à la page">
            <Path Data="M0 0l10 10M10 0L0 10" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
          </Button>
        </StackPanel>
      </Grid>

      <Border x:Name="Host" Grid.Row="1" Padding="16" />
    </Grid>
  </Border>
</Window>
