<Project>
  <!-- Réglages communs à tous les projets de la solution -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Company>Scanalyse</Company>
    <Product>Scanalyse</Product>
    <Copyright>© 2026 Scanalyse. Tous droits réservés.</Copyright>
    <!-- Version : modifier ici (ou -p:Version=… à la publication ; la compilation GitHub reprend le tag vX.Y.Z). -->
    <VersionPrefix>0.9.0</VersionPrefix>
    <NeutralLanguage>fr-FR</NeutralLanguage>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
