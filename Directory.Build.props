<Project>
  <!-- Réglages communs à tous les projets de la solution -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Company>Mr.Kanard</Company>
    <Authors>Mr.Kanard</Authors>
    <Product>Scanalyse</Product>
    <Copyright>© 2026 Mr.Kanard — logiciel libre sous licence GNU GPL v3</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <!-- Version : modifier ici (ou -p:Version=… à la publication ; la compilation GitHub reprend le tag vX.Y.Z). -->
    <VersionPrefix>0.11.1</VersionPrefix>
    <NeutralLanguage>fr-FR</NeutralLanguage>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
